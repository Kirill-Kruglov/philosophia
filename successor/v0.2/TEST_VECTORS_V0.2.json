  "pinned_encodings": {
    "seed_primitive": {
      "preimage": "\"philosophia-alias-v0.2|\" + namespace + \"|\" + \"|\".join(str(int(f)) for f in fields)",
      "digest": "first 8 bytes of SHA256(UTF8(preimage)), unsigned little-endian, masked to 63 bits",
      "levels": "stage namespace -> replicate_seed = seed64(stage, i); role seeds derive from replicate_seed, never from i"
    },
    "world_order": {
      "algorithm": "numpy.random.Generator(numpy.random.PCG64(world_order_seed)).permutation(pool) with pool in ascending order",
      "allocation_hash": "SHA256(UTF8(\"world-alloc-v0.2|M=<M>|stage=<stage>|i=<replicate_index>|\" + \",\".join(str(v) for v in permutation)))"
    },
    "pair_split": {
      "rank_key": "SHA256(UTF8(\"philosophia-alias-v0.2|pair-split|\" + str(pair_split_seed) + \"|\" + str(a) + \"|\" + str(b))), full 32 bytes compared as bytes",
      "tie_break": "(a,b) ascending",
      "train_count": "floor(0.70 * M^2)",
      "split_hash": "SHA256(b\"pair-split-v0.2|M=<M>|train|\" + train pairs in lexicographic order as two uint16 little-endian each + b\"|held|\" + held-out pairs likewise)",
      "split_hash_property": "set hash; independent of the ranked order"
    },
    "tensor_hash": {
      "source": "inherited from Level 0 model._hash_tensor",
      "rule": "SHA256(ascii(str(dtype)) || ascii(str(tuple(shape))) || detached.cpu().contiguous().numpy().tobytes())"
    },
    "state_dict_hash": {
      "rule": "SHA256 over name + \"|\" + tensor_hash concatenated in inherited parameter creation order",
      "parameter_order": ["W_E", "W_pos", "W_Q", "W_K", "W_V", "W_O", "W_in", "b_in", "W_out", "b_out", "W_U"]
    },
    "output_head": {
      "numeric_tokens": "2M-1",
      "equals_token": "2M-1",
      "vocabulary_size": "2M",
      "training_classes": "2M",
      "reporting_classes": "2M-1",
      "W_U_shape": "[d_model, vocabulary_size]",
      "note": "the '=' column is a trained but never-correct class, as at Level 0; narrowing W_U to 2M-1 is not authorized"
    },
    "batch_policy": {
      "policy": "full batch",
      "train_pairs_per_update": {"M96": 6451, "M128": 11468},
      "drop_last": false,
      "gradient_accumulation_steps": 1,
      "resolved_from": "MODEL_CONFIG_REF subtree (data.py + train.py)"
    },
    "context_scale_reference": {
      "rule": "median L2 norm over the numeric rows W_E[0 : 2M-1] only, excluding the '=' row, taken once at model initialization",
      "note": "2M-1 is odd at both authorized scales, so the median is an exact order statistic"
    }
  },
  "model_config_acceptance_projection": {
    "note": "byte-identity of v0.2_model_config.json across implementations is withdrawn as an acceptance item; it was never derivable from the bundle. The full config file stays free-form. Acceptance compares this canonical projection instead.",
    "serialization": "json.dumps(obj, sort_keys=True, separators=(\",\",\":\"), ensure_ascii=True) with no trailing newline, then SHA256 over the UTF-8 bytes",
    "keys": [
      "residual_width",
      "heads",
      "head_width",
      "mlp_width",
      "layers",
      "normalization",
      "activation",
      "optimizer_family",
      "learning_rate",
      "beta1",
      "beta2",
      "epsilon",
      "weight_decay",
      "warmup_updates",
      "lr_schedule",
      "batch_policy",
      "dtype",
      "sequence_length",
      "context_position",
      "readout_position",
      "max_position",
      "positional_table_rows_added",
      "numeric_tokens_96",
      "vocabulary_size_96",
      "training_classes_96",
      "reporting_classes_96",
      "equals_token_96",
      "numeric_tokens_128",
      "vocabulary_size_128",
      "training_classes_128",
      "reporting_classes_128",
      "equals_token_128",
      "torch_num_threads",
      "torch_num_interop_threads",
      "deterministic_algorithms",
      "config_py_sha256",
      "model_py_sha256"
    ]
  },
  "comparison_tolerance": {
    "integers_counts_flags_statuses_hashes": "exact",
    "real_valued_statistics": "absolute 1e-9",
    "rationale": "summation order can move the last ulp of s_d and the CI bounds; a 1-ulp difference is not a divergence, a status or count difference is"
  }
