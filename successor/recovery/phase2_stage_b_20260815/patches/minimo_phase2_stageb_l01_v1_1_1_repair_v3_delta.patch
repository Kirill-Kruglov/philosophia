+MIN_DECLARED_ATOMS = 3
+MAX_DECLARED_ATOMS = 6
+MIN_DEPENDENCY_DEPTH = 2
+MIN_FAMILY_COUNT = 3
+BRANCHING_FAMILIES = ('AND_INTRO', 'OR_ELIM')
