+#!/usr/bin/env python3
+"""Closed L0 enums, L1 causes and frozen mutation-to-cause mapping."""
+
+from __future__ import annotations
+
+
+CAUSE_PLAN_SCHEMA_INVALID = 'PLAN_SCHEMA_INVALID'
+CAUSE_PLAN_TYPE_INVALID = 'PLAN_TYPE_INVALID'
+CAUSE_PLAN_CONSTRAINT_INVALID = 'PLAN_CONSTRAINT_INVALID'
+CAUSE_PLAN_NON_NORMAL = 'PLAN_NON_NORMAL'
+
+L1_CAUSES = (
+    CAUSE_PLAN_SCHEMA_INVALID,
+    CAUSE_PLAN_TYPE_INVALID,
+    CAUSE_PLAN_CONSTRAINT_INVALID,
+    CAUSE_PLAN_NON_NORMAL,
+)
+
+# Unreachable at L1; first exercised at L3.
+CAUSE_SEQUENT_REDERIVATION_MISMATCH = 'SEQUENT_REDERIVATION_MISMATCH'
+
+CAUSE_QUERY_MEASUREMENT_OVERFLOW = 'QUERY_MEASUREMENT_OVERFLOW'
+
+TOP_LEVEL_TERMINALS = (
+    'DEV_CORE_FEASIBILITY_STOP',
+    'DEV_CORE_FEASIBLE_FOR_AUDIT_CONTRACT',
+)
+
+DEV_CORE_FEASIBILITY_STOP_REASONS = (
+    'PREMISE_ENUMERABILITY_FAILED',
+    'DAG_ENUMERABILITY_FAILED',
+    'DAG_REPLAY_FAILED',
+    'CHECKER_UNSOUND',
+    'COMPILER_UNSOUND',
+    'MUTATION_ESCAPE',
+    'PUBLIC_PROJECTION_LEAK',
+    'COLLISION_ACCOUNTING_ERROR',
+    'NONDETERMINISM',
+    'COMPILER_FAMILY_UNREACHABLE',
+    CAUSE_QUERY_MEASUREMENT_OVERFLOW,
+    'ROOT_QUOTA_UNFILLED',
+    'RESOURCE_CEILING_EXHAUSTED',
+)
+
+DRAW_CAUSES = (
+    'PLAN_CONSTRUCTION_FAILED',
+    CAUSE_PLAN_SCHEMA_INVALID,
+    CAUSE_PLAN_TYPE_INVALID,
+    CAUSE_PLAN_CONSTRAINT_INVALID,
+    CAUSE_PLAN_NON_NORMAL,
+    CAUSE_SEQUENT_REDERIVATION_MISMATCH,
+    'CLASSICAL_COUNTEREXAMPLE',
+    'THEOREM_ID_COLLISION',
+    'SKELETON_ID_COLLISION',
+    'COMPILER_NO_MATCH',
+    'COMPILER_AMBIGUOUS_MATCH',
+    'PEANO_REPLAY_REFUSAL',
+    'PEANO_REPLAY_NONTERMINAL',
+    CAUSE_QUERY_MEASUREMENT_OVERFLOW,
+    'TARGET_BAND_ALREADY_FULL',
+)
+
+MUTATION_TO_CAUSE = (
+    ('wrong kind/key/type/string/atom-name/ID/atom-list', CAUSE_PLAN_SCHEMA_INVALID),
+    ('duplicate or shadowed hypothesis ID', CAUSE_PLAN_SCHEMA_INVALID),
+    ('missing or out-of-scope hypothesis reference', CAUSE_PLAN_TYPE_INVALID),
+    ('wrong child/conclusion/root goal', CAUSE_PLAN_TYPE_INVALID),
+    ('wrong discharge formula', CAUSE_PLAN_TYPE_INVALID),
+    ('undeclared or unused declared atom', CAUSE_PLAN_CONSTRAINT_INVALID),
+    ('unused global/local hypothesis', CAUSE_PLAN_CONSTRAINT_INVALID),
+    ('duplicate global hypothesis formula', CAUSE_PLAN_CONSTRAINT_INVALID),
+    ('formula bound', CAUSE_PLAN_CONSTRAINT_INVALID),
+    ('node-count/band/expectation mismatch', CAUSE_PLAN_CONSTRAINT_INVALID),
+    ('shallow dependency/too few families/no branching', CAUSE_PLAN_CONSTRAINT_INVALID),
+    ('each section-2.3 beta-redex', CAUSE_PLAN_NON_NORMAL),
+)
