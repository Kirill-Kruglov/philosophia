+    validate_artifact_id,
+)
+from phase2_policy import ScientificLMPolicy, ScientificSamplingForbidden  # noqa: E402
+from phase2_spec import (  # noqa: E402
+    fingerprint_state_mapping,
+    tiny_scientific_spec,
+)
+
+
+def _payload_for_kind(codec: QueryCodec, kind: str, body: str) -> str:
+    if kind in ('state', 'value'):
+        return codec.format_kind(kind, state=body, label='')
+    if kind == 'action':
+        return codec.format_kind(kind, state='s', action=body, label='')
+    if kind == 'selector':
+        return codec.format_kind(kind, state='s', action=body)
+    if kind == 'conjecture':
+        return codec.format_kind(kind, outcome='easy', statement=body)
+    if kind == 'completion':
+        return codec.format_kind(kind, preamble='P:', completion=body)
+    if kind == 'training':
+        return codec.format_kind(kind, text=body)
+    raise AssertionError(kind)
+
+
+def _exact_fit_body(formatted_without_body: str, n_positions: int, overflow_tokens: int) -> int:
+    """Body length so BOS+formatted+EOS token_count == n_positions + overflow_tokens."""
+    # formatted = prefix + body + suffix; we pass the full formatted string to encode
+    # when using encode() directly. Here formatted_without_body is prefix+suffix length
+    # and we return body length.
+    target_text_len = n_positions + overflow_tokens - 2
+    return target_text_len - len(formatted_without_body)
+
+
+class TestQueryCodec(unittest.TestCase):
+    def setUp(self):
+        self.codec = QueryCodec(n_positions=32)
+
+    def test_non_ascii_rejected(self):
+        with self.assertRaises(NonAsciiQuery):
+            self.codec.encode('café', kind='training', artifact_id='t0')
+
+    def test_caller_lists_byte_identical(self):
+        texts = ['S: aa\n???', 'S: bb\n???']
+        ids = ['a', 'b']
+        before_t = [t.encode('ascii') for t in texts]
+        before_i = list(ids)
+        self.codec.encode_queries(texts, kind='state', artifact_ids=ids)
+        self.assertEqual([t.encode('ascii') for t in texts], before_t)
+        self.assertEqual(ids, before_i)
+
+    def test_padding_excluded_from_token_count(self):
+        encoded = self.codec.encode_queries(
+            ['ab', 'abcd'], kind='training', artifact_ids=['1', '2'])
+        tensor, lengths = self.codec.pad_batch(encoded)
+        self.assertEqual(lengths, (4, 6))  # BOS+2+EOS, BOS+4+EOS
+        self.assertEqual(tuple(encoded[0].token_ids).count(self.codec.pad_token_id), 0)
+        self.assertEqual(int((tensor[0] == self.codec.pad_token_id).sum()), 2)
+
+    def test_exact_fit_and_one_token_overflow_every_kind(self):
+        n_positions = 40
+        codec = QueryCodec(n_positions=n_positions)
+        for kind in QUERY_KINDS:
+            with self.subTest(kind=kind):
+                if kind in ('state', 'value'):
+                    prefix, suffix = 'S: ', '\n???'
+                    body_fit = _exact_fit_body(prefix + suffix, n_positions, 0)
+                    body_over = body_fit + 1
+                    fit = codec.format_kind(kind, state='x' * body_fit, label='')
+                    over = codec.format_kind(kind, state='x' * body_over, label='')
+                elif kind == 'action':
+                    fit = codec.format_action_query('s', 'x' * 8)
+                    # rebuild to exact token fit via encode of crafted text
+                    need = n_positions - 2
+                    fit = 'A' * need
+                    over = 'A' * (need + 1)
+                elif kind == 'selector':
+                    need = n_positions - 2
+                    fit = 'B' * need
+                    over = 'B' * (need + 1)
+                elif kind == 'conjecture':
+                    need = n_positions - 2
+                    fit = 'C' * need
+                    over = 'C' * (need + 1)
+                elif kind == 'completion':
+                    need = n_positions - 2
+                    fit = 'D' * need
+                    over = 'D' * (need + 1)
+                else:
+                    need = n_positions - 2
+                    fit = 'E' * need
+                    over = 'E' * (need + 1)
+                got = codec.encode(fit, kind=kind, artifact_id=f'{kind}-fit')
+                self.assertEqual(got.token_count, n_positions)
+                self.assertEqual(got.text, fit)
+                with self.assertRaises(QueryOverflowError) as ctx:
+                    codec.encode(over, kind=kind, artifact_id=f'{kind}-over')
+                rec = ctx.exception.record
+                self.assertEqual(rec.kind, kind)
+                self.assertEqual(rec.artifact_id, f'{kind}-over')
+                self.assertEqual(rec.token_count, n_positions + 1)
+                self.assertEqual(rec.limit, n_positions)
+                self.assertEqual(rec.byte_count, n_positions - 1)
+
+    def test_historical_755_767_admitted_or_typed_refused(self):
+        long_755 = 'Q' * 755
+        long_767 = 'R' * 767
+        admit = QueryCodec(n_positions=1024)
+        e755 = admit.encode(long_755, kind='state', artifact_id='hist755')
+        e767 = admit.encode(long_767, kind='training', artifact_id='hist767')
+        self.assertEqual(e755.text, long_755)
+        self.assertEqual(e767.text, long_767)
+        self.assertNotIn('[...]', e755.text)
+        self.assertNotIn('[...]', e767.text)
+        self.assertEqual(e755.token_count, 757)
+        self.assertEqual(e767.token_count, 769)
+        refuse = QueryCodec(n_positions=512)
+        with self.assertRaises(QueryOverflowError) as c755:
+            refuse.encode(long_755, kind='state', artifact_id='hist755')
+        with self.assertRaises(QueryOverflowError) as c767:
+            refuse.encode(long_767, kind='training', artifact_id='hist767')
+        self.assertEqual(c755.exception.record.byte_count, 755)
+        self.assertEqual(c767.exception.record.byte_count, 767)
+        self.assertGreater(c755.exception.record.token_count, 512)
+        self.assertGreater(c767.exception.record.token_count, 512)
+
+    def test_no_truncation_markers_in_codec_source(self):
+        source = (LEARNING_DIR / 'phase2_codec.py').read_text(encoding='utf-8')
+        self.assertNotIn('[...]', source)
+        self.assertNotIn('490', source)
+        self.assertNotIn('400', source)
+
+    def test_hand_computed_completion_likelihood_includes_eos_excludes_preamble(self):
+        preamble = 'AB'
+        completion = 'CD'
+        bos, eos = 1, 2
+        token_ids = [bos, ord('A'), ord('B'), ord('C'), ord('D'), eos]
+        vocab = 16
+        # logits[t] predicts token[t+1]; need 5 logit rows for tokens 1..5
+        logits = [[0.0] * 128 for _ in range(5)]
+        targets = token_ids[1:]  # A B C D EOS
+        for i, target in enumerate(targets):
+            logits[i][target] = 10.0
+        # Hand formula for included targets: C, D, EOS (indices 3,4,5) via logits 2,3,4
+        included = hand_computed_completion_logprob(
+            logits, token_ids, preamble_len=2, completion_len=2, bos=True, eos=True)
+        codec = QueryCodec(n_positions=32)
+        logit_tensor = torch.tensor([logits], dtype=torch.float32)
+        ids_tensor = torch.tensor([token_ids], dtype=torch.long)
+        got = codec.completion_logprobs_from_logits(
+            logit_tensor, ids_tensor, [2], [2], bos=True, eos=True)[0]
+        self.assertAlmostEqual(got, included, places=5)
+        positions = codec.completion_target_positions(preamble, completion)
+        self.assertEqual(positions, (2, 3, 4))
+        preamble_logit_indices = (0, 1)
+        for idx in preamble_logit_indices:
+            self.assertNotIn(idx, positions)
+        # Each included target has logit 10 vs 127 zeros.
+        logz = math.log(127 + math.exp(10.0))
+        expected_one = 10.0 - logz
+        self.assertAlmostEqual(included, 3 * expected_one, places=5)
+
+    def test_bos_false_empty_preamble_refuses_missing_causal_logit(self):
+        codec = QueryCodec(n_positions=32)
+        with self.assertRaises(QueryCodecError):
+            codec.completion_target_positions('', 'ab', bos=False, eos=True)
+        with self.assertRaises(QueryCodecError):
+            hand_computed_completion_logprob(
+                [[0.0] * 128],
+                [ord('a'), ord('b'), 2],
+                preamble_len=0,
+                completion_len=2,
+                bos=False,
+                eos=True,
+            )
+
+    def test_bos_false_nonempty_preamble_has_causal_logit(self):
+        codec = QueryCodec(n_positions=32)
+        positions = codec.completion_target_positions('A', 'B', bos=False, eos=True)
+        self.assertEqual(positions, (0, 1))
+        token_ids = [ord('A'), ord('B'), 2]
+        logits = [[0.0] * 128 for _ in range(2)]
+        logits[0][ord('B')] = 10.0
+        logits[1][2] = 10.0
+        included = hand_computed_completion_logprob(
+            logits, token_ids, preamble_len=1, completion_len=1, bos=False, eos=True)
+        logit_tensor = torch.tensor([logits], dtype=torch.float32)
+        ids_tensor = torch.tensor([token_ids], dtype=torch.long)
+        got = codec.completion_logprobs_from_logits(
+            logit_tensor, ids_tensor, [1], [1], bos=False, eos=True)[0]
+        self.assertAlmostEqual(got, included, places=5)
+
+    def test_preflight_blocks_optimizer_mutation_on_overflow(self):
+        spec = tiny_scientific_spec(n_positions=16)
+        policy = ScientificLMPolicy.from_spec(spec)
+        before = fingerprint_state_mapping(policy.optimizer.state_dict(), 'opt')
+        too_long = 'Z' * 40
+        with self.assertRaises(QueryOverflowError):
+            policy.gradient_step([too_long])
+        after = fingerprint_state_mapping(policy.optimizer.state_dict(), 'opt')
+        self.assertEqual(before, after)
+        ok = 'ok'
+        policy.gradient_step([ok])
+        mutated = fingerprint_state_mapping(policy.optimizer.state_dict(), 'opt')
+        self.assertNotEqual(before, mutated)
+
+    def test_scientific_sampling_forbidden(self):
+        spec = tiny_scientific_spec()
+        policy = ScientificLMPolicy.from_spec(spec)
+        with self.assertRaises(ScientificSamplingForbidden):
+            policy.sample_provable_goals('ctx')
+        with self.assertRaises(ScientificSamplingForbidden):
+            policy.sample_actions('state')
+
+    def test_artifact_id_shared_bound_and_validator(self):
+        self.assertEqual(ARTIFACT_ID_MAX_BYTES, 512)
+        self.assertEqual(validate_artifact_id('item'), 'item')
+        self.assertEqual(validate_artifact_id('A' * ARTIFACT_ID_MAX_BYTES), 'A' * ARTIFACT_ID_MAX_BYTES)
+        with self.assertRaises(ArtifactIdError):
+            validate_artifact_id('é')
+        with self.assertRaises(ArtifactIdError):
+            validate_artifact_id('A' * (ARTIFACT_ID_MAX_BYTES + 1))
+        with self.assertRaises(ArtifactIdError):
+            validate_artifact_id('')
+        with self.assertRaises(ArtifactIdError):
+            validate_artifact_id(True)
+        with self.assertRaises(ArtifactIdError):
+            self.codec.encode('ab', kind='training', artifact_id='é')
+        with self.assertRaises(ArtifactIdError):
+            self.codec.encode('ab', kind='training', artifact_id='A' * (ARTIFACT_ID_MAX_BYTES + 1))
