+class DummyPolicy:
+    def initialize(self, leaf):
+        children = leaf.children() or []
+        n = max(1, len(children))
+        for child in children:
+            child._prior_policy = 1.0 / n
+            child._value_estimate = 0.0
+
+    def evaluate(self, leaf):
+        children = leaf.children() or []
+        if not children:
+            return np.array([1.0]), 0.0
+        n = len(children)
+        return np.ones(n) / n, 0.0
+
+
+class ScientificFakeNode:
+    """Test-only duck-typed search node. Not a real Peano tree. Not production evidence."""
+
+    def __init__(
+            self,
+            terminal=False,
+            solved=False,
+            parent=(None, None),
+            action_name='a0',
+            terminal_at_depth=None,
+            depth=0,
+            raw_actions=None,
+            mark_only_solved=False,
+            state_text=None,
+            child_state_text=None,
+            enumeration_job=None,
+    ):
+        self._terminal = bool(terminal)
+        self._solved = bool(solved)
+        self._parent = parent
+        self._action_name = action_name
+        self._children = None
+        self._visits = 0
+        self._reward = 0
+        self._prior_policy = 1.0
+        self._value_estimate = 0.0
+        self._index = None
+        self._is_dead = False
+        self._terminal_at_depth = terminal_at_depth
+        self._depth = depth
+        self._raw_actions = list(raw_actions) if raw_actions is not None else None
+        self._mark_only_solved = mark_only_solved
+        self._state_text = state_text if state_text is not None else f'state@{depth}:{action_name}'
+        self._child_state_text = child_state_text
+        self._enumeration_job = enumeration_job
+        self.state_node = self
+
+    def __str__(self):
+        return self._state_text
+
+    def is_conjunctive(self):
+        return False
+
+    def is_terminal(self):
+        return self._terminal
+
+    def is_solved(self):
+        if self._solved:
+            return True
+        if self._mark_only_solved:
+            return False
+        if self._terminal:
+            return True
+        if self._children:
+            return any(c.is_solved() for c in self._children)
+        return False
+
+    def is_leaf(self):
+        return (not self._terminal) and self._children is None
+
+    def is_dead(self):
+        return self._is_dead
+
+    def mark_dead(self):
+        self._is_dead = True
+
+    def mark_solved(self, action=None):
+        self._solved = True
+        parent, parent_action = self._parent
+        if parent is not None:
+            parent.mark_solved(parent_action)
+
+    def children(self):
+        return self._children
+
+    @property
+    def actions(self):
+        if self._children is None:
+            raise AssertionError('Node must be expanded to get actions.')
+        return [c._parent[1] for c in self._children]
+
+    def scientific_enumeration_job(self):
+        if self._enumeration_job is not None:
+            return self._enumeration_job
+        if self._raw_actions is not None:
+            return ('explicit', list(self._raw_actions))
+        return ('explicit', [self._action_name])
+
+    def enumerable_actions(self):
+        if self._raw_actions is not None:
+            return list(self._raw_actions)
+        return [self._action_name]
+
+    def stage_children_from_actions(self, ordered_actions):
+        children = []
+        for action in ordered_actions:
+            child_depth = self._depth + 1
+            child_terminal = (
+                self._terminal_at_depth is not None
+                and child_depth >= self._terminal_at_depth
+            )
+            name = action if isinstance(action, str) else str(action)
+            if self._child_state_text is not None:
+                child_state = self._child_state_text
+            else:
+                child_state = self._state_text + '|' + name
+            child = ScientificFakeNode(
+                terminal=child_terminal,
+                parent=(self, name),
+                action_name=name,
+                terminal_at_depth=self._terminal_at_depth,
+                depth=child_depth,
+                mark_only_solved=self._mark_only_solved,
+                state_text=child_state,
+            )
+            children.append(child)
+        return children
+
+    def expand_from_actions(self, ordered_actions):
+        self._children = self.stage_children_from_actions(ordered_actions)
+
+    def get_path_from_root(self, root=None):
+        if self is root or self._parent[0] is None:
+            return []
+        parent, action = self._parent
+        return parent.get_path_from_root(root) + [action]
+
+
+def _attach_dummy_child(root):
+    child = ScientificFakeNode(parent=(root, 'dummy'), action_name='dummy', depth=1)
+    child._visits = 1
+    child._reward = 0.0
+    child._prior_policy = 1.0
+    root._children = [child]
+    root._visits = 1
+    return child
+
+
+def _run(root, budget, **kwargs):
+    codec = QueryCodec(n_positions=kwargs.pop('n_positions', 512))
+    mcts = ScientificMonteCarloTreeSearch(
+        DummyPolicy(),
+        budget=budget,
+        codec=codec,
+        action_timeout_s=kwargs.pop('action_timeout_s', 1.0),
+        artifact_id=kwargs.pop('artifact_id', 'item'),
+    )
+    record, pi, value = mcts.evaluate(
+        root, start_index=kwargs.get('start_index', 0), verbose=False)
+    return record, pi, value
+
+
+class TestScientificSearchCounters(unittest.TestCase):
