+    def test_action_scores_are_priors_child_scores_are_values(self):
+        spec = tiny_scientific_spec(n_positions=64)
+        sci = ScientificLMPolicy.from_spec(spec)
+
+        class SwapSensitiveLogitModel:
+            def __init__(self, inner):
+                self._inner = inner
+
+            def parameters(self):
+                return self._inner.parameters()
+
+            def eval(self):
+                self._inner.eval()
+                return self
+
+            def train(self, mode=True):
+                return self._inner.train(mode)
+
+            def __call__(self, token_ids, attention_mask=None):
+                batch, seq, vocab = token_ids.shape[0], token_ids.shape[1], 128
+                logits = torch.zeros(batch, seq, vocab)
+                eos_id = 2
+                for i in range(batch):
+                    eos_pos = None
+                    for j in range(int(token_ids.shape[1]) - 1, -1, -1):
+                        if int(token_ids[i, j].item()) == eos_id:
+                            eos_pos = j
+                            break
+                    if eos_pos is None:
+                        raise AssertionError('missing EOS in swap fixture')
+                    payload = bytes(
+                        int(tok) for tok in token_ids[i].tolist() if int(tok) not in (0, 1, 2)
+                    )
+                    payload_pos = eos_pos - 1
+                    if b'\nA: ' in payload:
+                        logits[i, payload_pos, ord('Y')] = 8.0
+                        logits[i, payload_pos, ord('N')] = 0.0
+                    else:
+                        logits[i, payload_pos, ord('Y')] = 0.0
+                        logits[i, payload_pos, ord('N')] = 8.0
+                return type('Out', (), {'logits': logits})()
+
+        sci.model = SwapSensitiveLogitModel(sci.model)
+        node = ScientificFakeNode(raw_actions=['act'])
+        node.expand_from_actions(['act'])
+        sci.initialize(node)
+        child = node.children()[0]
+        self.assertGreater(child._prior_policy, 0.4)
+        self.assertLess(child._value_estimate, 0.2)
+        self.assertLess(node._value_estimate, 0.2)
+        prior_score = float(sci.estimate_state_action_values('st', ['act'])[0])
+        value_score = float(sci.estimate_state_values(['hello'])[0])
+        self.assertGreater(prior_score, 0.9)
+        self.assertLess(value_score, 0.2)
