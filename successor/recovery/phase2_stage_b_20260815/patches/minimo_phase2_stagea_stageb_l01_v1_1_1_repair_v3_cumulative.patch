+#!/usr/bin/env python3
+"""Contract E: hindsight statement repair."""
+
+from __future__ import annotations
+
+import ast
+import sys
+import unittest
+from pathlib import Path
+
+LEARNING_DIR = Path(__file__).resolve().parent
+if str(LEARNING_DIR) not in sys.path:
+    sys.path.insert(0, str(LEARNING_DIR))
+
+from phase2_hindsight import format_hindsight_conjecture_example  # noqa: E402
+
+
+class DummyDerivation:
+    def elaborate(self, statement: str) -> str:
+        return f'ELAB({statement})'
+
+
+def _upstream_buggy(elaborate, outcome, parent_problem, hindsight_statement):
+    del hindsight_statement
+    return f'Conj:({outcome}) ' + elaborate(parent_problem)
+
+
+class TestHindsightStatement(unittest.TestCase):
+    def test_fixture_fails_on_upstream_bug_and_passes_after_repair(self):
+        parent = 'PARENT_PROBLEM_STATEMENT'
+        hindsight = 'HINDSIGHT_GOAL_STATEMENT'
+        self.assertNotEqual(parent, hindsight)
+        d = DummyDerivation()
+        buggy = _upstream_buggy(d.elaborate, 'easy', parent, hindsight)
+        self.assertIn(parent, buggy)
+        self.assertNotIn(hindsight, buggy)
+        repaired = format_hindsight_conjecture_example(d.elaborate, 'easy', hindsight)
+        self.assertIn(hindsight, repaired)
+        self.assertNotIn(parent, repaired)
+        self.assertEqual(repaired, 'Conj:(easy) ELAB(HINDSIGHT_GOAL_STATEMENT)')
+
+    def test_bootstrap_hindsight_loop_uses_h_statement(self):
+        source = (LEARNING_DIR / 'bootstrap.py').read_text(encoding='utf-8')
+        self.assertIn('format_hindsight_conjecture_example', source)
+        tree = ast.parse(source)
+        found = False
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+            func = node.func
+            name = None
+            if isinstance(func, ast.Name):
+                name = func.id
+            if name != 'format_hindsight_conjecture_example':
+                continue
+            found = True
+            self.assertGreaterEqual(len(node.args), 3)
+            stmt = node.args[2]
+            self.assertIsInstance(stmt, ast.Attribute)
+            self.assertEqual(stmt.attr, 'statement')
+            self.assertIsInstance(stmt.value, ast.Name)
+            self.assertEqual(stmt.value.id, 'h')
+        self.assertTrue(found)
+
+
+if __name__ == '__main__':
+    unittest.main()
