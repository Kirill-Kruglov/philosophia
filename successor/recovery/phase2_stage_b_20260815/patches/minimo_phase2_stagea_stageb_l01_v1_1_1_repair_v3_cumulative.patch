index 0000000..9d5df27
--- /dev/null
+++ b/learning/phase2_actions.py
@@ -0,0 +1,421 @@
+#!/usr/bin/env python3
+"""Canonical full action handling for the scientific search path.
+
+Raw Peano enumeration order may vary. Downstream bytes are sorted by unique
+ASCII serialization. The legacy 75-character prefix filter is not applied.
+
+Real TreeSearchNode expansion pairs original action objects with unique ASCII
+serializations inside the isolated whole-item worker. Semantic action objects
+never cross the process boundary. The parent-process synthetic helper is
+test-only.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Sequence
+
+from phase2_codec import ArtifactIdError, QueryCodec, QueryOverflowError, validate_artifact_id
+from phase2_timeout import IsolatedEnumerationTimeout, run_interruptible_enumeration
+
+
+class ActionHandlingError(ValueError):
+    """Scientific action-space refusal."""
+
+
+class UncontainedPeanoError(RuntimeError):
+    """Real Peano expansion attempted outside the isolated whole-item worker."""
+
+
+# Identity-checked in-tree call-graph marker for the isolated whole-item worker.
+# Not a Python security capability: importing this module yields the token.
+# Public factories never accept a caller-supplied bypass; they pass None.
+_WHOLE_ITEM_WORKER_CAPABILITY = object()
+
+
+def whole_item_worker_capability_granted(capability) -> bool:
+    return capability is _WHOLE_ITEM_WORKER_CAPABILITY
+
+
+class ActionEnumerationTimeout(ActionHandlingError):
+    def __init__(self, elapsed_s: float, timeout_s: float):
+        self.elapsed_s = float(elapsed_s)
+        self.timeout_s = float(timeout_s)
+        super().__init__(
+            f'action enumeration timeout elapsed={self.elapsed_s:.6f}s '
+            f'limit={self.timeout_s:.6f}s'
+        )
+
+
+class DuplicateActionSerialization(ActionHandlingError):
+    def __init__(self, serialization: str):
+        self.serialization = serialization
+        super().__init__(f'duplicate action serialization {serialization!r}')
+
+
+class ItemQueryOverflowRefusal(ActionHandlingError):
+    """Whole item refused before search; siblings are not deleted."""
+
+    def __init__(self, artifact_id: str, overflow: QueryOverflowError):
+        self.artifact_id = artifact_id
+        self.overflow = overflow
+        super().__init__(
+            f'item {artifact_id} refused: complete query overflow ({overflow})'
+        )
+
+
+class ArtifactIdLimitRefusal(ActionHandlingError):
+    """Hierarchical artifact ID exceeded the codec/transport ASCII byte bound."""
+
+    def __init__(self, *, attempted: str, byte_count: int, limit: int):
+        self.attempted = attempted
+        self.byte_count = int(byte_count)
+        self.limit = int(limit)
+        self.prefix = _artifact_id_prefix(attempted, self.limit)
+        super().__init__(
+            f'artifact id exceeded {self.limit} ASCII bytes '
+            f'(byte_count={self.byte_count})'
+        )
+
+    @classmethod
+    def from_error(cls, exc: ArtifactIdError):
+        attempted = exc.artifact_id if type(exc.artifact_id) is str else ''
+        if exc.byte_count is not None:
+            byte_count = exc.byte_count
+        elif type(attempted) is str:
+            try:
+                byte_count = len(attempted.encode('ascii'))
+            except UnicodeEncodeError:
+                byte_count = len(attempted.encode('utf-8'))
+        else:
+            byte_count = 0
+        return cls(attempted=attempted, byte_count=byte_count, limit=exc.limit)
+
+
+class PeanoPanicRefusal(ActionHandlingError):
+    """Formal Peano/PyO3 panic. Distinct from an infrastructure child crash."""
+
+    def __init__(self, message: str, *, exception_module: str, exception_class: str):
+        self.exception_module = exception_module
+        self.exception_class = exception_class
+        super().__init__(message)
+
+
+def _artifact_id_prefix(attempted, limit: int) -> str:
+    if type(attempted) is not str:
+        return 'x'
+    try:
+        raw = attempted.encode('ascii')
+    except UnicodeEncodeError:
+        raw = attempted.encode('ascii', 'replace')
+    if not raw:
+        return 'x'
+    text = raw[:limit].decode('ascii')
+    return text if text else 'x'
+
+
+def is_pyo3_panic(exc: BaseException) -> bool:
+    cls = type(exc)
+    return cls.__module__ == 'pyo3_runtime' and cls.__name__ == 'PanicException'
+
+
+def is_real_peano_state_node(state_node) -> bool:
+    if state_node is None:
+        return False
+    from proofsearch import HolophrasmNode, ProofStateNode
+    return isinstance(state_node, (ProofStateNode, HolophrasmNode))
+
+
+def refuse_uncontained_peano(node, worker_capability) -> None:
+    """Refuse real Peano nodes/proxies before MCTS, action access, or mutation."""
+    if is_real_tree_search_node(node):
+        if not whole_item_worker_capability_granted(worker_capability):
+            raise UncontainedPeanoError(
+                'real Peano TreeSearchNode cannot be searched in-process; '
+                'use run_isolated_scientific_item'
+            )
+        return
+    state = getattr(node, 'state_node', None)
+    if is_real_peano_state_node(state):
+        raise UncontainedPeanoError(
+            'Peano-backed proxy cannot be searched in-process; '
+            'use run_isolated_scientific_item'
+        )
+
+
+def canonical_action_ascii(action) -> str:
+    text = action if isinstance(action, str) else str(action)
+    if not isinstance(text, str):
+        raise ActionHandlingError('action serialization is not a str')
+    try:
+        text.encode('ascii')
+    except UnicodeEncodeError as exc:
+        raise ActionHandlingError('action serialization is not ASCII') from exc
+    return text
+
+
+def canonicalize_action_serializations(serials: Sequence[str]) -> list[str]:
+    """Require unique ASCII and sort before any child construction."""
+    materialized = [canonical_action_ascii(item) for item in serials]
+    seen: dict[str, int] = {}
+    for serial in materialized:
+        if serial in seen:
+            raise DuplicateActionSerialization(serial)
+        seen[serial] = 1
+    return sorted(materialized)
+
+
+def canonicalize_actions(raw_actions, *, timeout_s: float = 1.0) -> list:
+    """Unique-sort already-materialized actions. Live enumerators use the isolated job."""
+    if not isinstance(raw_actions, (list, tuple)):
+        raise ActionHandlingError(
+            'canonicalize_actions requires a list; live enumerators must use '
+            'materialize_actions_interruptible'
+        )
+    return canonicalize_action_serializations(
+        [canonical_action_ascii(action) for action in raw_actions]
+    )
+
+
+def canonicalize_action_object_pairs(raw_actions) -> list[tuple[str, object]]:
+    """Pair each unique ASCII serialization with its original action object, then sort."""
+    if not isinstance(raw_actions, (list, tuple)):
+        raise ActionHandlingError('canonicalize_action_object_pairs requires a list')
+    pairs: list[tuple[str, object]] = []
+    seen: dict[str, int] = {}
+    for action in raw_actions:
+        serial = canonical_action_ascii(action)
+        if serial in seen:
+            raise DuplicateActionSerialization(serial)
+        seen[serial] = 1
+        pairs.append((serial, action))
+    pairs.sort(key=lambda item: item[0])
+    return pairs
+
+
+def is_real_tree_search_node(leaf) -> bool:
+    from proofsearch import TreeSearchNode
+    return isinstance(leaf, TreeSearchNode)
+
+
+def materialize_actions_interruptible(job: tuple, timeout_s: float) -> list[str]:
+    try:
+        raw = run_interruptible_enumeration(job, timeout_s)
+    except IsolatedEnumerationTimeout as exc:
+        raise ActionEnumerationTimeout(exc.elapsed_s, exc.timeout_s) from exc
+    return canonicalize_action_serializations(raw)
+
+
+@dataclass(frozen=True)
+class CanonicalExpansion:
+    ordered_actions: tuple[object, ...]
+    ordered_serializations: tuple[str, ...]
+    policy_queries: tuple[str, ...]
+    value_queries: tuple[str, ...]
+    child_state_strings: tuple[str, ...]
+
+
+def preflight_action_policy_queries(
+        codec: QueryCodec,
+        state: str,
+        ordered_actions: Sequence,
+        *,
+        artifact_id: str,
+) -> tuple[str, ...]:
+    queries: list[str] = []
+    snapshot_state = state
+    snapshot_actions = tuple(ordered_actions)
+    for i, action in enumerate(snapshot_actions):
+        serial = canonical_action_ascii(action)
+        query = codec.format_action_query(snapshot_state, serial)
+        query_id = f'{artifact_id}:a{i}'
+        try:
+            query_id = validate_artifact_id(query_id)
+            codec.encode(query, kind='action', artifact_id=query_id)
+        except ArtifactIdError as exc:
+            raise ArtifactIdLimitRefusal.from_error(exc) from exc
+        except QueryOverflowError as exc:
+            raise ItemQueryOverflowRefusal(artifact_id, exc) from exc
+        queries.append(query)
+    if state != snapshot_state:
+        raise ActionHandlingError('preflight mutated state')
+    if tuple(ordered_actions) != snapshot_actions:
+        raise ActionHandlingError('preflight mutated action list')
+    return tuple(queries)
+
+
+def preflight_child_value_queries(
+        codec: QueryCodec,
+        child_states: Sequence[str],
+        *,
+        artifact_id: str,
+) -> tuple[str, ...]:
+    queries: list[str] = []
+    snapshot = tuple(child_states)
+    for i, state in enumerate(snapshot):
+        query = codec.format_state_query(state)
+        query_id = f'{artifact_id}:v{i}'
+        try:
+            query_id = validate_artifact_id(query_id)
+            codec.encode(query, kind='value', artifact_id=query_id)
+        except ArtifactIdError as exc:
+            raise ArtifactIdLimitRefusal.from_error(exc) from exc
+        except QueryOverflowError as exc:
+            raise ItemQueryOverflowRefusal(artifact_id, exc) from exc
+        queries.append(query)
+    if tuple(child_states) != snapshot:
+        raise ActionHandlingError('preflight mutated child states')
+    return tuple(queries)
+
+
+def _snapshot_leaf(leaf) -> dict:
+    return {
+        'children': leaf._children,
+        'canonical_expansion': getattr(leaf, '_canonical_expansion', None),
+    }
+
+
+def _leaf_unchanged(leaf, snapshot) -> bool:
+    return (
+        leaf._children is snapshot['children']
+        and getattr(leaf, '_canonical_expansion', None) is snapshot['canonical_expansion']
+    )
+
+
+def expand_leaf_canonical(
+        leaf,
+        *,
+        codec: QueryCodec,
+        artifact_id: str,
+        timeout_s: float | None = None,
+        child_factory=None,
+        worker_capability=None,
+) -> CanonicalExpansion:
+    """Stage children locally; mutate the leaf only after complete preflight."""
+    refuse_uncontained_peano(leaf, worker_capability)
+    if is_real_tree_search_node(leaf):
+        return _expand_real_leaf_in_isolated_worker(
+            leaf, codec=codec, artifact_id=artifact_id)
+    if timeout_s is None:
+        raise ActionHandlingError(
+            'synthetic test-only expand requires timeout_s'
+        )
+    return _expand_synthetic_leaf_for_tests(
+        leaf,
+        codec=codec,
+        timeout_s=timeout_s,
+        artifact_id=artifact_id,
+        child_factory=child_factory,
+    )
+
+
+def _commit_canonical_expansion(
+        leaf,
+        *,
+        ordered_actions,
+        ordered_serializations,
+        staged,
+        action_queries,
+        value_queries,
+        child_states,
+) -> CanonicalExpansion:
+    leaf._children = staged
+    expansion = CanonicalExpansion(
+        ordered_actions=tuple(ordered_actions),
+        ordered_serializations=tuple(ordered_serializations),
+        policy_queries=action_queries,
+        value_queries=value_queries,
+        child_state_strings=child_states,
+    )
+    leaf._canonical_expansion = expansion
+    return expansion
+
+
+def _expand_real_leaf_in_isolated_worker(
+        leaf,
+        *,
+        codec: QueryCodec,
+        artifact_id: str,
+) -> CanonicalExpansion:
+    """Enumerate, pair, sort, and stage original action objects in this worker."""
+    snapshot = _snapshot_leaf(leaf)
+    raw = list(leaf.state_node.actions)
+    pairs = canonicalize_action_object_pairs(raw)
+    ordered_serializations = [serial for serial, _action in pairs]
+    ordered_actions = [action for _serial, action in pairs]
+    if not hasattr(leaf, 'stage_children_from_actions'):
+        raise ActionHandlingError('real leaf cannot stage canonical children')
+    staged = leaf.stage_children_from_actions(ordered_actions)
+    child_states = tuple(str(child.state_node) for child in staged)
+    state_str = str(leaf.state_node)
+    try:
+        action_queries = preflight_action_policy_queries(
+            codec, state_str, ordered_serializations, artifact_id=artifact_id)
+        value_queries = preflight_child_value_queries(
+            codec, child_states, artifact_id=artifact_id)
+    except (ItemQueryOverflowRefusal, ArtifactIdLimitRefusal):
+        if not _leaf_unchanged(leaf, snapshot):
+            raise ActionHandlingError('overflow preflight mutated leaf')
+        raise
+    return _commit_canonical_expansion(
+        leaf,
+        ordered_actions=ordered_actions,
+        ordered_serializations=ordered_serializations,
+        staged=staged,
+        action_queries=action_queries,
+        value_queries=value_queries,
+        child_states=child_states,
+    )
+
+
+def _expand_synthetic_leaf_for_tests(
+        leaf,
+        *,
+        codec: QueryCodec,
+        timeout_s: float,
+        artifact_id: str,
+        child_factory=None,
+) -> CanonicalExpansion:
+    """Test-only FakeNode path. String jobs are not production Peano evidence."""
+    snapshot = _snapshot_leaf(leaf)
+    if is_real_peano_state_node(getattr(leaf, 'state_node', None)):
+        raise UncontainedPeanoError(
+            'Peano-backed proxy cannot be expanded on the synthetic path'
+        )
+    if not hasattr(leaf, 'scientific_enumeration_job'):
+        raise ActionHandlingError(
+            'synthetic expand requires scientific_enumeration_job()'
+        )
+    job = leaf.scientific_enumeration_job()
+    try:
+        ordered = materialize_actions_interruptible(job, timeout_s)
+    except ActionEnumerationTimeout:
+        if not _leaf_unchanged(leaf, snapshot):
+            raise ActionHandlingError('timeout mutated leaf')
+        raise
+    state_str = str(leaf.state_node)
+    if child_factory is not None:
+        staged = [child_factory(leaf, action) for action in ordered]
+    elif hasattr(leaf, 'stage_children_from_actions'):
+        staged = leaf.stage_children_from_actions(ordered)
+    else:
+        raise ActionHandlingError('leaf cannot stage canonical children')
+    child_states = tuple(str(child.state_node) for child in staged)
+    try:
+        action_queries = preflight_action_policy_queries(
+            codec, state_str, ordered, artifact_id=artifact_id)
+        value_queries = preflight_child_value_queries(
+            codec, child_states, artifact_id=artifact_id)
+    except (ItemQueryOverflowRefusal, ArtifactIdLimitRefusal):
+        if not _leaf_unchanged(leaf, snapshot):
+            raise ActionHandlingError('overflow preflight mutated leaf')
+        raise
+    return _commit_canonical_expansion(
+        leaf,
+        ordered_actions=ordered,
+        ordered_serializations=ordered,
+        staged=staged,
+        action_queries=action_queries,
+        value_queries=value_queries,
+        child_states=child_states,
+    )
diff --git a/learning/phase2_codec.py b/learning/phase2_codec.py
new file mode 100644
index 0000000..ce56f00
--- /dev/null
+++ b/learning/phase2_codec.py
@@ -0,0 +1,400 @@
+#!/usr/bin/env python3
+"""Pure immutable ASCII query codec for the scientific route.
+
+Never truncates, clips, elides, mutates, retries, or edits caller lists.
+Batch padding does not enter likelihood or length accounting.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterable, Sequence
+
+import torch
+import torch.nn.functional as F
+
+
+QUERY_KINDS = (
+    'state',
+    'value',
+    'action',
+    'conjecture',
+    'selector',
+    'completion',
+    'training',
+)
+
+ARTIFACT_ID_MAX_BYTES = 512
+
+
+class QueryCodecError(ValueError):
+    """Scientific codec refusal."""
+
+
+class ArtifactIdError(QueryCodecError):
+    """Artifact ID is not a nonempty ASCII string within ARTIFACT_ID_MAX_BYTES."""
+
+    def __init__(self, artifact_id, *, byte_count=None, reason='invalid'):
+        self.artifact_id = artifact_id
+        self.byte_count = byte_count
+        self.limit = ARTIFACT_ID_MAX_BYTES
+        self.reason = reason
+        super().__init__(
+            f'artifact id refused reason={reason} byte_count={byte_count} '
+            f'limit={ARTIFACT_ID_MAX_BYTES}'
+        )
+
+
+def validate_artifact_id(value) -> str:
+    """Exact nonempty ASCII string of at most ARTIFACT_ID_MAX_BYTES bytes."""
+    if type(value) is not str:
+        raise ArtifactIdError(value, reason='type')
+    if value == '':
+        raise ArtifactIdError(value, byte_count=0, reason='empty')
+    try:
+        encoded = value.encode('ascii')
+    except UnicodeEncodeError as exc:
+        raise ArtifactIdError(value, reason='non-ascii') from exc
+    if len(encoded) > ARTIFACT_ID_MAX_BYTES:
+        raise ArtifactIdError(value, byte_count=len(encoded), reason='overlong')
+    return value
+
+
+class NonAsciiQuery(QueryCodecError):
+    """Payload is not ASCII."""
+
+
+@dataclass(frozen=True)
+class QueryOverflow:
+    """Typed overflow record. Never silently truncated."""
+
+    kind: str
+    artifact_id: str
+    byte_count: int
+    token_count: int
+    limit: int
+
+
+class QueryOverflowError(QueryCodecError):
+    def __init__(self, record: QueryOverflow):
+        self.record = record
+        super().__init__(
+            f'query overflow kind={record.kind} artifact={record.artifact_id} '
+            f'bytes={record.byte_count} tokens={record.token_count} limit={record.limit}'
+        )
+
+
+@dataclass(frozen=True)
+class EncodedQuery:
+    kind: str
+    artifact_id: str
+    text: str
+    token_ids: tuple[int, ...]
+    byte_count: int
+    token_count: int
+    bos: bool
+    eos: bool
+
+
+class QueryCodec:
+    """Immutable ASCII codec with explicit BOS/EOS policy."""
+
+    def __init__(
+            self,
+            *,
+            n_positions: int,
+            bos_token_id: int = 1,
+            eos_token_id: int = 2,
+            pad_token_id: int = 0,
+            vocab_size: int = 128,
+    ):
+        if n_positions < 1:
+            raise QueryCodecError('n_positions must be positive')
+        self.n_positions = int(n_positions)
+        self.bos_token_id = int(bos_token_id)
+        self.eos_token_id = int(eos_token_id)
+        self.pad_token_id = int(pad_token_id)
+        self.vocab_size = int(vocab_size)
+
+    def format_state_query(self, state: str, label: str = '') -> str:
+        self._require_ascii(state, 'state')
+        self._require_ascii(label, 'label')
+        return f'S: {state}\n???{label}'
+
+    def format_value_query(self, state: str, label: str) -> str:
+        return self.format_state_query(state, label)
+
+    def format_action_query(self, state: str, action: str, label: str = '') -> str:
+        self._require_ascii(state, 'state')
+        self._require_ascii(action, 'action')
+        self._require_ascii(label, 'label')
+        return f'S: {state}\nA: {action}\n???{label}'
+
+    def format_selector_query(self, state: str, action: str) -> str:
+        self._require_ascii(state, 'state')
+        self._require_ascii(action, 'action')
+        return f'S: {state}\nSTEP: {action}'
+
+    def format_conjecture_query(self, outcome: str, statement: str) -> str:
+        self._require_ascii(outcome, 'outcome')
+        self._require_ascii(statement, 'statement')
+        return f'Conj:({outcome}) {statement}'
+
+    def format_provable_goal(self, context: str, goal: str) -> str:
+        self._require_ascii(context, 'context')
+        self._require_ascii(goal, 'goal')
+        return f'S: {context}\nENTAILS: {goal}'
+
+    def format_training_example(self, example: str) -> str:
+        self._require_ascii(example, 'training')
+        return example
+
+    def format_kind(self, kind: str, **fields) -> str:
+        if kind not in QUERY_KINDS:
+            raise QueryCodecError(f'unknown query kind {kind!r}')
+        if kind in ('state', 'value'):
+            return self.format_state_query(fields['state'], fields.get('label', ''))
+        if kind == 'action':
+            return self.format_action_query(
+                fields['state'], fields['action'], fields.get('label', ''))
+        if kind == 'selector':
+            if 'goal' in fields:
+                return self.format_provable_goal(fields['context'], fields['goal'])
+            return self.format_selector_query(fields['state'], fields['action'])
+        if kind == 'conjecture':
+            return self.format_conjecture_query(fields['outcome'], fields['statement'])
+        if kind == 'completion':
+            preamble = fields['preamble']
+            completion = fields['completion']
+            self._require_ascii(preamble, 'preamble')
+            self._require_ascii(completion, 'completion')
+            return preamble + completion
+        if kind == 'training':
+            return self.format_training_example(fields['text'])
+        raise QueryCodecError(f'unhandled query kind {kind!r}')
+
+    def encode(
+            self,
+            text: str,
+            *,
+            kind: str,
+            artifact_id: str,
+            bos: bool = True,
+            eos: bool = True,
+            n_positions: int | None = None,
+    ) -> EncodedQuery:
+        if kind not in QUERY_KINDS:
+            raise QueryCodecError(f'unknown query kind {kind!r}')
+        if not isinstance(text, str):
+            raise QueryCodecError('query text must be a str')
+        artifact_id = validate_artifact_id(artifact_id)
+        self._require_ascii(text, kind)
+        reserved = {self.pad_token_id, self.bos_token_id, self.eos_token_id}
+        payload = tuple(text.encode('ascii'))
+        for byte in payload:
+            if byte in reserved:
+                raise QueryCodecError(
+                    f'payload byte {byte} collides with BOS/EOS/PAD in {kind}'
+                )
+            if byte >= self.vocab_size:
+                raise QueryCodecError(
+                    f'payload byte {byte} outside vocab_size={self.vocab_size}'
+                )
+        ids = []
+        if bos:
+            ids.append(self.bos_token_id)
+        ids.extend(payload)
+        if eos:
+            ids.append(self.eos_token_id)
+        token_count = len(ids)
+        limit = self.n_positions if n_positions is None else int(n_positions)
+        byte_count = len(payload)
+        if token_count > limit:
+            raise QueryOverflowError(QueryOverflow(
+                kind=kind,
+                artifact_id=artifact_id,
+                byte_count=byte_count,
+                token_count=token_count,
+                limit=limit,
+            ))
+        return EncodedQuery(
+            kind=kind,
+            artifact_id=artifact_id,
+            text=text,
+            token_ids=tuple(ids),
+            byte_count=byte_count,
+            token_count=token_count,
+            bos=bool(bos),
+            eos=bool(eos),
+        )
+
+    def encode_queries(
+            self,
+            texts: Sequence[str],
+            *,
+            kind: str,
+            artifact_ids: Sequence[str],
+            bos: bool = True,
+            eos: bool = True,
+    ) -> list[EncodedQuery]:
+        snapshot = tuple(texts)
+        id_snapshot = tuple(artifact_ids)
+        if len(snapshot) != len(id_snapshot):
+            raise QueryCodecError('texts and artifact_ids must have equal length')
+        encoded = [
+            self.encode(text, kind=kind, artifact_id=artifact_id, bos=bos, eos=eos)
+            for text, artifact_id in zip(snapshot, id_snapshot)
+        ]
+        if tuple(texts) != snapshot:
+            raise QueryCodecError('codec mutated caller text list')
+        if tuple(artifact_ids) != id_snapshot:
+            raise QueryCodecError('codec mutated caller artifact id list')
+        return encoded
+
+    def pad_batch(
+            self,
+            encoded: Sequence[EncodedQuery],
+            *,
+            device: torch.device | str = 'cpu',
+    ) -> tuple[torch.Tensor, tuple[int, ...]]:
+        """Pad on the right. Padding is not part of token_count or likelihood."""
+        if not encoded:
+            empty = torch.zeros((0, 0), dtype=torch.long, device=device)
+            return empty, ()
+        lengths = tuple(item.token_count for item in encoded)
+        max_len = max(lengths)
+        rows = [
+            list(item.token_ids) + [self.pad_token_id] * (max_len - item.token_count)
+            for item in encoded
+        ]
+        tensor = torch.tensor(rows, dtype=torch.long, device=device)
+        return tensor, lengths
+
+    def preflight_training_batch(
+            self,
+            examples: Sequence[str],
+            *,
+            artifact_prefix: str = 'train',
+    ) -> list[EncodedQuery]:
+        snapshot = tuple(examples)
+        encoded = self.encode_queries(
+            snapshot,
+            kind='training',
+            artifact_ids=tuple(f'{artifact_prefix}:{i}' for i in range(len(snapshot))),
+        )
+        if tuple(examples) != snapshot:
+            raise QueryCodecError('preflight mutated caller training list')
+        return encoded
+
+    def completion_target_positions(
+            self,
+            preamble: str,
+            completion: str,
+            *,
+            bos: bool = True,
+            eos: bool = True,
+    ) -> tuple[int, ...]:
+        """Logit indices whose next-token targets are completion bytes and EOS.
+
+        Sequence: [BOS?] + preamble_bytes + completion_bytes + [EOS?]
+        Include every completion byte and EOS once. Exclude BOS and preamble bytes.
+        """
+        self._require_ascii(preamble, 'preamble')
+        self._require_ascii(completion, 'completion')
+        bos_off = 1 if bos else 0
+        first_completion = bos_off + len(preamble.encode('ascii'))
+        last_completion = first_completion + len(completion.encode('ascii'))
+        # logit[t] predicts token[t+1]. Targets live at token indices
+        # first_completion .. last_completion (EOS) inclusive if eos else
+        # first_completion .. last_completion-1.
+        if eos:
+            last_target_token = last_completion  # EOS index
+        else:
+            last_target_token = last_completion - 1
+        if last_target_token < first_completion:
+            return ()
+        first_logit = first_completion - 1
+        if first_logit < 0:
+            raise QueryCodecError(
+                'bos=False leaves no preceding causal logit for the first completion target'
+            )
+        return tuple(range(first_logit, last_target_token))
+
+    def completion_logprobs_from_logits(
+            self,
+            logits: torch.Tensor,
+            token_ids: torch.Tensor,
+            preamble_byte_lens: Sequence[int],
+            completion_byte_lens: Sequence[int],
+            *,
+            bos: bool = True,
+            eos: bool = True,
+    ) -> list[float]:
+        """Sum log P of completion bytes and EOS. Padding never contributes."""
+        logprobs = F.log_softmax(logits, dim=-1)
+        out: list[float] = []
+        bos_off = 1 if bos else 0
+        for i, (p_len, c_len) in enumerate(zip(preamble_byte_lens, completion_byte_lens)):
+            first_completion = bos_off + int(p_len)
+            eos_index = first_completion + int(c_len) if eos else first_completion + int(c_len) - 1
+            if eos:
+                target_token_from = first_completion
+                target_token_to = eos_index
+            else:
+                target_token_from = first_completion
+                target_token_to = first_completion + int(c_len) - 1
+            total = logits.new_zeros(())
+            for token_index in range(target_token_from, target_token_to + 1):
+                logit_index = token_index - 1
+                if logit_index < 0:
+                    raise QueryCodecError(
+                        'bos=False leaves no preceding causal logit for the first completion target'
+                    )
+                target = token_ids[i, token_index]
+                if int(target.item()) == self.pad_token_id:
+                    raise QueryCodecError('padding entered completion likelihood')
+                total = total + logprobs[i, logit_index, target]
+            out.append(float(total.item()))
+        return out
+
+    @staticmethod
+    def _require_ascii(text: str, name: str) -> None:
+        if not isinstance(text, str):
+            raise QueryCodecError(f'{name} must be a str')
+        try:
+            text.encode('ascii')
+        except UnicodeEncodeError as exc:
+            raise NonAsciiQuery(f'{name} is not ASCII') from exc
+
+
+def hand_computed_completion_logprob(
+        logits_row: Sequence[Sequence[float]],
+        token_ids: Sequence[int],
+        *,
+        preamble_len: int,
+        completion_len: int,
+        bos: bool = True,
+        eos: bool = True,
+) -> float:
+    """Independent numpy-free reference for one unpadded sequence."""
+    import math
+
+    bos_off = 1 if bos else 0
+    first_completion = bos_off + preamble_len
+    last_token = first_completion + completion_len  # EOS index if eos else last completion
+    if not eos:
+        last_token = first_completion + completion_len - 1
+    total = 0.0
+    for token_index in range(first_completion, last_token + 1):
+        logit_index = token_index - 1
+        if logit_index < 0:
+            raise QueryCodecError(
+                'bos=False leaves no preceding causal logit for the first completion target'
+            )
+        row = logits_row[logit_index]
+        target = token_ids[token_index]
+        m = max(row)
+        exps = [math.exp(x - m) for x in row]
+        z = sum(exps)
+        total += (row[target] - m) - math.log(z)
+    return total
