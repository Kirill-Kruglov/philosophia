+#!/usr/bin/env python3
+"""Contract E/G: scientific path cannot reach forbidden surfaces."""
+
+from __future__ import annotations
+
+import ast
+import sys
+import unittest
+from pathlib import Path
+
+LEARNING_DIR = Path(__file__).resolve().parent
+if str(LEARNING_DIR) not in sys.path:
+    sys.path.insert(0, str(LEARNING_DIR))
+
+
+PHASE2_MODULES = [
+    'phase2_spec.py',
+    'phase2_codec.py',
+    'phase2_actions.py',
+    'phase2_search.py',
+    'phase2_policy.py',
+    'phase2_hindsight.py',
+    'phase2_config.py',
+    'phase2_timeout.py',
+    'phase2_root.py',
+    'phase2_isolated.py',
+]
+
+
+def _is_cuda_available_call(node: ast.AST) -> bool:
+    if not isinstance(node, ast.Call):
+        return False
+    func = node.func
+    # torch.cuda.is_available()
+    if isinstance(func, ast.Attribute) and func.attr == 'is_available':
+        val = func.value
+        if isinstance(val, ast.Attribute) and val.attr == 'cuda':
+            return True
+    return False
+
+
+def _enclosing_function(tree: ast.AST, target: ast.AST) -> str | None:
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            if target.lineno >= node.lineno and (
+                    node.end_lineno is None or target.lineno <= node.end_lineno):
+                # prefer the innermost later; first pass collect
+                pass
+    innermost = None
+    for node in ast.walk(tree):
+        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            continue
+        if node.end_lineno is None:
+            continue
+        if node.lineno <= target.lineno <= node.end_lineno:
+            if innermost is None or node.lineno >= innermost.lineno:
+                innermost = node
+    return None if innermost is None else innermost.name
+
+
+class TestScientificExclusions(unittest.TestCase):
+    def test_phase2_modules_have_no_wandb_celery_distributed(self):
+        for name in PHASE2_MODULES:
+            source = (LEARNING_DIR / name).read_text(encoding='utf-8')
+            with self.subTest(name=name):
+                self.assertNotIn('wandb', source)
+                self.assertNotIn('celery', source)
+                self.assertNotIn('Celery', source)
+                self.assertNotIn('DISTRIBUTED', source)
+                self.assertNotIn('MAX_ACTION_LENGTH', source)
+                self.assertNotIn('[...]', source)
+                self.assertNotIn('random.choice', source)
+                self.assertNotIn('random.sample', source)
+                self.assertNotIn('sample_batch', source)
+                self.assertNotIn('np.random', source)
+
+    def test_cuda_is_available_only_rejects_device(self):
+        source = (LEARNING_DIR / 'phase2_spec.py').read_text(encoding='utf-8')
+        tree = ast.parse(source)
+        calls = [n for n in ast.walk(tree) if _is_cuda_available_call(n)]
+        self.assertEqual(len(calls), 1)
+        self.assertEqual(_enclosing_function(tree, calls[0]), 'reject_unavailable_device')
+        fn_src = ast.get_source_segment(source, [
+            n for n in ast.walk(tree)
+            if isinstance(n, ast.FunctionDef) and n.name == 'reject_unavailable_device'
+        ][0])
+        self.assertNotIn('n_layer', fn_src)
+        self.assertNotIn('n_head', fn_src)
+        self.assertNotIn('n_embd', fn_src)
+        construct_src = ast.get_source_segment(source, [
+            n for n in ast.walk(tree)
+            if isinstance(n, ast.FunctionDef) and n.name == 'construct_scientific_lm'
+        ][0])
+        self.assertNotIn('is_available', construct_src)
+
+    def test_scientific_expand_does_not_filter_max_action_length(self):
+        source = (LEARNING_DIR / 'phase2_actions.py').read_text(encoding='utf-8')
+        self.assertNotIn('MAX_ACTION_LENGTH', source)
+        self.assertIn('canonicalize_actions', source)
+        expand_src = (LEARNING_DIR / 'proofsearch.py').read_text(encoding='utf-8')
+        start = expand_src.index('def expand_from_actions')
+        chunk = expand_src[start:start + 400]
+        self.assertNotIn('MAX_ACTION_LENGTH', chunk)
+        stage_start = expand_src.index('def stage_children_from_actions')
+        stage_chunk = expand_src[stage_start:stage_start + 400]
+        self.assertNotIn('MAX_ACTION_LENGTH', stage_chunk)
+
+    def test_legacy_expand_still_filters(self):
+        source = (LEARNING_DIR / 'proofsearch.py').read_text(encoding='utf-8')
+        start = source.index('def expand(self, only_if_leaf=True)')
+        chunk = source[start:source.index('def enumerable_actions')]
+        self.assertIn('MAX_ACTION_LENGTH', chunk)
+
+    def test_scientific_policy_has_no_wandb_log(self):
+        source = (LEARNING_DIR / 'phase2_policy.py').read_text(encoding='utf-8')
+        self.assertNotIn('wandb.log', source)
+        self.assertNotIn('do_sample', source)
+
+    def test_bootstrap_hindsight_not_parent_problem(self):
+        source = (LEARNING_DIR / 'bootstrap.py').read_text(encoding='utf-8')
+        start = source.index('if cfg.train_policy_on_hindsight_examples:')
+        end = source.index("save_json(examples, f'examples_{i}.json')")
+        chunk = source[start:end]
+        self.assertIn('h.statement', chunk)
+        self.assertIn('format_hindsight_conjecture_example', chunk)
+        self.assertNotIn('d.elaborate(student_result.problem)', chunk)
+
+    def test_capability_token_only_on_root_isolated_worker_path(self):
+        allowed = {
+            'phase2_actions.py',
+            'phase2_root.py',
+            'phase2_isolated.py',
+        }
+        scanned = list(PHASE2_MODULES) + ['policy.py', 'bootstrap.py', 'proofsearch.py']
+        for name in scanned:
+            if name in allowed:
+                continue
+            source = (LEARNING_DIR / name).read_text(encoding='utf-8')
+            with self.subTest(name=name):
+                self.assertNotIn('_WHOLE_ITEM_WORKER_CAPABILITY', source)
+
+
+if __name__ == '__main__':
+    unittest.main()
