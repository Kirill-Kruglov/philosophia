+    def test_stable_two_class_softmax_survives_large_logits(self):
+        pos = two_class_positive_probability(torch.tensor(1000.0), torch.tensor(-1000.0))
+        neg = two_class_positive_probability(torch.tensor(-1000.0), torch.tensor(1000.0))
