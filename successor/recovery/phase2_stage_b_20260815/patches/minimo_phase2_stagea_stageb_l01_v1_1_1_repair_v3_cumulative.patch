+#!/usr/bin/env python3
+"""Fail-closed scientific learner identity: spec, constructor, checkpoint manifest.
+
+Architecture is taken only from the closed spec. Device availability may reject
+a requested device; it never selects n_layer/n_head/n_embd/n_positions.
+Dropout is pinned to zero. All AdamW flags used at construction are explicit.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from typing import Any, Mapping
+
+import torch
+import transformers
+
+
+SCIENTIFIC_SPEC_KEYS = (
+    'device',
+    'dtype',
+    'n_layer',
+    'n_head',
+    'n_embd',
+    'n_positions',
+    'vocab_size',
+    'bos_token_id',
+    'eos_token_id',
+    'pad_token_id',
+    'optimizer_type',
+    'optimizer_lr',
+    'optimizer_betas',
+    'optimizer_eps',
+    'optimizer_weight_decay',
+    'optimizer_amsgrad',
+    'optimizer_maximize',
+    'optimizer_foreach',
+    'optimizer_capturable',
+    'optimizer_differentiable',
+    'optimizer_fused',
+    'attn_pdrop',
+    'embd_pdrop',
+    'resid_pdrop',
+    'expected_parameter_count',
+    'init_seed',
+)
+
+# Pinned Torch CPU Generator aliases seed s with s + 2**32, so 2**32 aliases 0
+# and accepted V4.3.1 seeds 0, 2**32, and 2**62 produced identical streams.
+# Accept only [0, 2**32 - 1].
+TORCH_INIT_SEED_MAX = (1 << 32) - 1
+
+_ALLOWED_DTYPES = {
+    'float32': torch.float32,
+    'float64': torch.float64,
+}
+
+_BOOL_OPT_KEYS = (
+    'optimizer_amsgrad',
+    'optimizer_maximize',
+    'optimizer_foreach',
+    'optimizer_capturable',
+    'optimizer_differentiable',
+    'optimizer_fused',
+)
+
+_DROPOUT_KEYS = ('attn_pdrop', 'embd_pdrop', 'resid_pdrop')
+
+_RESOLVED_CONFIG_SKIP = ('_name_or_path',)
+
+
+class ScientificSpecError(ValueError):
+    """Missing, extra, or internally inconsistent scientific spec."""
+
+
+class ScientificDeviceUnavailable(RuntimeError):
+    """Requested device is not available. Architecture is not substituted."""
+
+
+class ScientificLoadMismatch(ValueError):
+    """Checkpoint manifest does not match the constructed learner."""
+
+
+def canonical_dumps(obj: Any) -> str:
+    return json.dumps(obj, sort_keys=True, separators=(',', ':'), ensure_ascii=True)
+
+
+def gpt2_parameter_count(
+        *,
+        n_layer: int,
+        n_embd: int,
+        n_positions: int,
+        vocab_size: int,
+        n_inner: int | None = None,
+) -> int:
+    """Independent GPT-2 LM-head parameter count with tied input/output embeddings."""
+    inner = int(n_inner) if n_inner is not None else 4 * int(n_embd)
+    wte = vocab_size * n_embd
+    wpe = n_positions * n_embd
+    ln_f = 2 * n_embd
+    ln = 2 * n_embd
+    c_attn = n_embd * (3 * n_embd) + (3 * n_embd)
+    c_proj = n_embd * n_embd + n_embd
+    c_fc = n_embd * inner + inner
+    c_mlp_proj = inner * n_embd + n_embd
+    per_layer = ln + c_attn + c_proj + ln + c_fc + c_mlp_proj
+    return int(wte + wpe + ln_f + n_layer * per_layer)
+
+
+def canonical_spec_dict(spec: Mapping[str, Any]) -> dict:
+    validated = validate_scientific_spec(spec)
+    return {key: validated[key] for key in SCIENTIFIC_SPEC_KEYS}
+
+
+def canonical_spec_hash(spec: Mapping[str, Any]) -> str:
+    payload = canonical_dumps(canonical_spec_dict(spec)).encode('ascii')
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _require_bool(spec: Mapping[str, Any], key: str) -> bool:
+    value = spec[key]
+    if type(value) is not bool:
+        raise ScientificSpecError(f'{key} must be a bool')
+    return value
+
+
+def _require_zero_dropout(spec: Mapping[str, Any], key: str) -> float:
+    value = spec[key]
+    if type(value) is bool or type(value) not in (int, float):
+        raise ScientificSpecError(f'{key} must be numeric zero')
+    if float(value) != 0.0:
+        raise ScientificSpecError(f'{key} must be 0 on the scientific route')
+    return 0.0
+
+
+def _require_finite_number(
+        value,
+        key: str,
+        *,
+        min_inclusive: float | None = None,
+        min_exclusive: float | None = None,
+        max_exclusive: float | None = None,
+) -> float:
+    if type(value) is bool or type(value) not in (int, float):
+        raise ScientificSpecError(f'{key} must be an exact int or float')
+    number = float(value)
+    if not math.isfinite(number):
+        raise ScientificSpecError(f'{key} must be finite')
+    if min_inclusive is not None and number < min_inclusive:
+        raise ScientificSpecError(f'{key} must be >= {min_inclusive}')
+    if min_exclusive is not None and number <= min_exclusive:
+        raise ScientificSpecError(f'{key} must be > {min_exclusive}')
+    if max_exclusive is not None and number >= max_exclusive:
+        raise ScientificSpecError(f'{key} must be < {max_exclusive}')
+    return number
+
+
+def _require_device_syntax(device) -> str:
+    if type(device) is not str or not device:
+        raise ScientificSpecError('device must be a nonempty str')
+    if device == 'cpu':
+        return device
+    if device.startswith('cuda:'):
+        rest = device[5:]
+        if not rest.isdigit() or (len(rest) > 1 and rest[0] == '0'):
+            raise ScientificSpecError('device must be cpu or canonical cuda:N')
+        return f'cuda:{int(rest)}'
+    raise ScientificSpecError('device must be cpu or canonical cuda:N')
+
+
+def validate_scientific_spec(spec: Mapping[str, Any]) -> dict:
+    if not isinstance(spec, Mapping):
+        raise ScientificSpecError('scientific spec must be a mapping')
+    keys = tuple(spec.keys())
+    extra = [k for k in keys if k not in SCIENTIFIC_SPEC_KEYS]
+    missing = [k for k in SCIENTIFIC_SPEC_KEYS if k not in spec]
+    if missing or extra:
+        raise ScientificSpecError(
+            f'scientific spec must contain exactly {list(SCIENTIFIC_SPEC_KEYS)}; '
+            f'missing={missing} extra={extra}'
+        )
+    device = _require_device_syntax(spec['device'])
+    dtype_name = spec['dtype']
+    if type(dtype_name) is not str:
+        raise ScientificSpecError('dtype must be an exact str')
+    if dtype_name not in _ALLOWED_DTYPES:
+        raise ScientificSpecError(
+            f'dtype must be one of {sorted(_ALLOWED_DTYPES)}; got {dtype_name!r}'
+        )
+    ints = ('n_layer', 'n_head', 'n_embd', 'n_positions', 'vocab_size',
+            'bos_token_id', 'eos_token_id', 'pad_token_id',
+            'expected_parameter_count')
+    out = {'device': device, 'dtype': dtype_name}
+    for key in ints:
+        value = spec[key]
+        if type(value) is bool or type(value) is not int:
+            raise ScientificSpecError(f'{key} must be an int')
+        if value < 0:
+            raise ScientificSpecError(f'{key} must be non-negative')
+        out[key] = value
+    init_seed = spec['init_seed']
+    if type(init_seed) is bool or type(init_seed) is not int:
+        raise ScientificSpecError('init_seed must be an exact non-negative int')
+    if init_seed < 0 or init_seed > TORCH_INIT_SEED_MAX:
+        raise ScientificSpecError(
+            f'init_seed must be in [0, {TORCH_INIT_SEED_MAX}]; '
+            '2**32 aliases 0 on the pinned Torch CPU generator'
+        )
+    out['init_seed'] = init_seed
+    if out['n_layer'] < 1 or out['n_head'] < 1 or out['n_embd'] < 1:
+        raise ScientificSpecError('n_layer, n_head, n_embd must be positive')
+    if out['n_positions'] < 1 or out['vocab_size'] < 1:
+        raise ScientificSpecError('n_positions and vocab_size must be positive')
+    if out['expected_parameter_count'] < 1:
+        raise ScientificSpecError('expected_parameter_count must be positive')
+    if out['n_embd'] % out['n_head'] != 0:
+        raise ScientificSpecError('n_embd must be divisible by n_head')
+    if spec['optimizer_type'] != 'AdamW':
+        raise ScientificSpecError("optimizer_type must be 'AdamW'")
+    out['optimizer_type'] = 'AdamW'
+    out['optimizer_lr'] = _require_finite_number(
+        spec['optimizer_lr'], 'optimizer_lr', min_inclusive=0.0)
+    out['optimizer_eps'] = _require_finite_number(
+        spec['optimizer_eps'], 'optimizer_eps', min_exclusive=0.0)
+    out['optimizer_weight_decay'] = _require_finite_number(
+        spec['optimizer_weight_decay'], 'optimizer_weight_decay', min_inclusive=0.0)
+    betas = spec['optimizer_betas']
+    if type(betas) not in (list, tuple) or len(betas) != 2:
+        raise ScientificSpecError('optimizer_betas must be a pair')
+    out['optimizer_betas'] = [
+        _require_finite_number(
+            betas[0], 'optimizer_betas[0]', min_inclusive=0.0, max_exclusive=1.0),
+        _require_finite_number(
+            betas[1], 'optimizer_betas[1]', min_inclusive=0.0, max_exclusive=1.0),
+    ]
+    for key in _BOOL_OPT_KEYS:
+        out[key] = _require_bool(spec, key)
+    if out['optimizer_fused'] and out['optimizer_foreach']:
+        raise ScientificSpecError(
+            'optimizer_fused and optimizer_foreach are incompatible'
+        )
+    if out['optimizer_fused'] and out['optimizer_differentiable']:
+        raise ScientificSpecError(
+            'optimizer_fused and optimizer_differentiable are incompatible'
+        )
+    for key in _DROPOUT_KEYS:
+        out[key] = _require_zero_dropout(spec, key)
+    ids = {out['bos_token_id'], out['eos_token_id'], out['pad_token_id']}
+    if len(ids) != 3:
+        raise ScientificSpecError('bos/eos/pad token IDs must be distinct')
+    if max(ids) >= out['vocab_size']:
+        raise ScientificSpecError('token IDs must lie in [0, vocab_size)')
+    formula = gpt2_parameter_count(
+        n_layer=out['n_layer'],
+        n_embd=out['n_embd'],
+        n_positions=out['n_positions'],
+        vocab_size=out['vocab_size'],
+    )
+    if out['expected_parameter_count'] != formula:
+        raise ScientificSpecError(
+            'expected_parameter_count does not match the GPT-2 formula: '
+            f'{out["expected_parameter_count"]} != {formula}'
+        )
+    return out
+
+
+def reject_unavailable_device(device: str) -> None:
+    """Reject an unavailable requested device. Do not substitute architecture."""
+    parsed = _require_device_syntax(device)
+    if parsed == 'cpu':
+        return
+    index = int(parsed.split(':', 1)[1])
+    if not torch.cuda.is_available():
+        raise ScientificDeviceUnavailable(
+            f'requested device {parsed!r} is unavailable'
+        )
+    count = int(torch.cuda.device_count())
+    if index >= count:
+        raise ScientificDeviceUnavailable(
+            f'requested device {parsed!r} is out of range (count={count})'
+        )
+
+
+def count_model_parameters(model: torch.nn.Module) -> int:
+    return int(sum(math.prod(p.shape) for p in model.parameters()))
+
+
+def _tensor_fingerprint(tensor: torch.Tensor) -> bytes:
+    cpu = tensor.detach().to('cpu').contiguous()
+    header = f'{cpu.dtype}|{tuple(cpu.shape)}|'.encode('ascii')
+    return header + cpu.numpy().tobytes()
+
+
+def fingerprint_state_mapping(mapping: Mapping[str, Any], prefix: str = '') -> str:
+    digest = hashlib.sha256()
+
+    def walk(obj: Any, path: str) -> None:
+        if torch.is_tensor(obj):
+            digest.update(path.encode('ascii'))
+            digest.update(_tensor_fingerprint(obj))
+            return
+        if isinstance(obj, Mapping):
+            for key in sorted(obj.keys(), key=str):
+                walk(obj[key], f'{path}.{key}')
+            return
+        if isinstance(obj, (list, tuple)):
+            for i, item in enumerate(obj):
+                walk(item, f'{path}[{i}]')
+            return
+        digest.update(path.encode('ascii'))
+        digest.update(repr(obj).encode('ascii'))
+
+    walk(mapping, prefix)
+    return digest.hexdigest()
+
+
+def resolved_model_config_dict(model: torch.nn.Module) -> dict:
+    raw = model.config.to_dict()
+    for key in _RESOLVED_CONFIG_SKIP:
+        raw.pop(key, None)
+    return json.loads(canonical_dumps(raw))
+
+
+def resolved_model_config_hash(model: torch.nn.Module) -> str:
+    payload = canonical_dumps(resolved_model_config_dict(model)).encode('ascii')
+    return hashlib.sha256(payload).hexdigest()
+
+
+def runtime_implementation_identity() -> dict:
+    return {
+        'torch_version': str(torch.__version__),
+        'transformers_version': str(transformers.__version__),
+    }
+
+
+def make_checkpoint_manifest(
+        spec: Mapping[str, Any],
+        model: torch.nn.Module,
+        optimizer: torch.optim.Optimizer,
+) -> dict:
+    canonical = canonical_spec_dict(spec)
+    identity = runtime_implementation_identity()
+    resolved = resolved_model_config_dict(model)
+    return {
+        'spec': canonical,
+        'spec_hash': canonical_spec_hash(canonical),
+        'parameter_count': count_model_parameters(model),
+        'state_dict_hash': fingerprint_state_mapping(model.state_dict(), 'state'),
+        'optimizer_state_hash': fingerprint_state_mapping(optimizer.state_dict(), 'opt'),
+        'resolved_model_config': resolved,
+        'resolved_model_config_hash': hashlib.sha256(
+            canonical_dumps(resolved).encode('ascii')
+        ).hexdigest(),
+        'torch_version': identity['torch_version'],
+        'transformers_version': identity['transformers_version'],
+    }
+
+
+def assert_manifest_matches(expected: Mapping[str, Any], actual: Mapping[str, Any]) -> None:
+    fields = (
+        'spec_hash',
+        'parameter_count',
+        'state_dict_hash',
+        'optimizer_state_hash',
+        'resolved_model_config_hash',
+        'torch_version',
+        'transformers_version',
+    )
+    for field in fields:
+        if expected.get(field) != actual.get(field):
+            raise ScientificLoadMismatch(
+                f'checkpoint manifest mismatch on {field}: '
+                f'expected {expected.get(field)!r} actual {actual.get(field)!r}'
+            )
+    if canonical_dumps(expected.get('spec')) != canonical_dumps(actual.get('spec')):
+        raise ScientificLoadMismatch('checkpoint manifest spec mismatch')
+
+
+def load_scientific_checkpoint(
+        blob: Mapping[str, Any],
+        expected_manifest: Mapping[str, Any],
+        model: torch.nn.Module,
+        optimizer: torch.optim.Optimizer,
+) -> None:
+    """Load weights only if the blob manifest matches the expected fingerprint."""
+    blob_manifest = blob.get('manifest')
+    if not isinstance(blob_manifest, Mapping):
+        raise ScientificLoadMismatch('checkpoint blob missing manifest')
+    assert_manifest_matches(expected_manifest, blob_manifest)
+    model.load_state_dict(blob['model_state_dict'])
+    optimizer.load_state_dict(blob['optimizer_state_dict'])
+    loaded = make_checkpoint_manifest(blob_manifest['spec'], model, optimizer)
+    assert_manifest_matches(expected_manifest, loaded)
+
+
+class ScientificLanguageModel:
+    """Constructed GPT-2 LM plus optimizer bound to a closed scientific spec."""
+
+    def __init__(self, spec: Mapping[str, Any], model, optimizer, manifest: dict):
+        self.spec = canonical_spec_dict(spec)
+        self.spec_hash = canonical_spec_hash(self.spec)
+        self.model = model
+        self.optimizer = optimizer
+        self.parameter_count = manifest['parameter_count']
+        self.manifest = manifest
+
+
+def construct_scientific_lm(spec: Mapping[str, Any]) -> ScientificLanguageModel:
+    """Build the scientific LM from a closed spec. Never branches on CUDA for size."""
+    validated = validate_scientific_spec(spec)
+    reject_unavailable_device(validated['device'])
+    cfg = transformers.GPT2Config(
+        vocab_size=validated['vocab_size'],
+        n_layer=validated['n_layer'],
+        n_head=validated['n_head'],
+        n_embd=validated['n_embd'],
+        bos_token_id=validated['bos_token_id'],
+        eos_token_id=validated['eos_token_id'],
+        pad_token_id=validated['pad_token_id'],
+        n_positions=validated['n_positions'],
+        attn_pdrop=validated['attn_pdrop'],
+        embd_pdrop=validated['embd_pdrop'],
+        resid_pdrop=validated['resid_pdrop'],
+    )
+    device = torch.device(validated['device'])
+    dtype = _ALLOWED_DTYPES[validated['dtype']]
+    ambient_dtype = torch.get_default_dtype()
+    ambient_device = torch.get_default_device()
+    ambient_rng = torch.get_rng_state()
+    try:
+        torch.set_default_dtype(dtype)
+        torch.set_default_device(torch.device('cpu'))
+        with torch.random.fork_rng(enabled=True):
+            torch.manual_seed(int(validated['init_seed']))
+            model = transformers.GPT2LMHeadModel(cfg)
+        model = model.to(device=device, dtype=dtype)
+        actual = count_model_parameters(model)
+        if actual != validated['expected_parameter_count']:
+            raise ScientificSpecError(
+                'actual parameter count does not match expected_parameter_count: '
+                f'{actual} != {validated["expected_parameter_count"]}'
+            )
+        optimizer = torch.optim.AdamW(
+            model.parameters(),
+            lr=validated['optimizer_lr'],
+            betas=tuple(validated['optimizer_betas']),
+            eps=validated['optimizer_eps'],
+            weight_decay=validated['optimizer_weight_decay'],
+            amsgrad=validated['optimizer_amsgrad'],
+            maximize=validated['optimizer_maximize'],
+            foreach=validated['optimizer_foreach'],
+            capturable=validated['optimizer_capturable'],
+            differentiable=validated['optimizer_differentiable'],
+            fused=validated['optimizer_fused'],
+        )
+        manifest = make_checkpoint_manifest(validated, model, optimizer)
+        if manifest['parameter_count'] != validated['expected_parameter_count']:
+            raise ScientificSpecError('manifest parameter count mismatch')
+        return ScientificLanguageModel(validated, model, optimizer, manifest)
+    finally:
+        torch.set_default_dtype(ambient_dtype)
+        torch.set_default_device(ambient_device)
+        torch.set_rng_state(ambient_rng)
+
+
+def _closed_spec_body() -> dict:
+    return {
+        'device': 'cpu',
+        'dtype': 'float32',
+        'n_layer': 2,
+        'n_head': 2,
+        'n_embd': 128,
+        'n_positions': 512,
+        'vocab_size': 128,
+        'bos_token_id': 1,
+        'eos_token_id': 2,
+        'pad_token_id': 0,
+        'optimizer_type': 'AdamW',
+        'optimizer_lr': 1e-4,
+        'optimizer_betas': [0.9, 0.999],
+        'optimizer_eps': 1e-8,
+        'optimizer_weight_decay': 0.01,
+        'optimizer_amsgrad': False,
+        'optimizer_maximize': False,
+        'optimizer_foreach': False,
+        'optimizer_capturable': False,
+        'optimizer_differentiable': False,
+        'optimizer_fused': False,
+        'attn_pdrop': 0.0,
+        'embd_pdrop': 0.0,
+        'resid_pdrop': 0.0,
+        'init_seed': 0,
+    }
+
+
+def cpu_debug_scientific_spec() -> dict:
+    """Closed spec matching the repository-default CPU-debug geometry, dropout 0."""
+    spec = _closed_spec_body()
+    spec['expected_parameter_count'] = gpt2_parameter_count(
+        n_layer=spec['n_layer'],
+        n_embd=spec['n_embd'],
+        n_positions=spec['n_positions'],
+        vocab_size=spec['vocab_size'],
+    )
+    return spec
+
+
+def tiny_scientific_spec(n_positions: int = 64) -> dict:
+    spec = cpu_debug_scientific_spec()
+    spec.update({
+        'n_layer': 1,
+        'n_head': 1,
+        'n_embd': 32,
+        'n_positions': int(n_positions),
+    })
+    spec['expected_parameter_count'] = gpt2_parameter_count(
+        n_layer=spec['n_layer'],
+        n_embd=spec['n_embd'],
+        n_positions=spec['n_positions'],
+        vocab_size=spec['vocab_size'],
+    )
+    return spec
