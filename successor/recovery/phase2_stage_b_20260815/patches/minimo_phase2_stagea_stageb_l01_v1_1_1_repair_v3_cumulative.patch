+#!/usr/bin/env python3
+"""Single-source max_pos_neg_ratio. No silent alias to max_positive_negative_ratio."""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+
+CANONICAL_MAX_POS_NEG_RATIO_KEY = 'max_pos_neg_ratio'
+FORBIDDEN_MAX_POS_NEG_RATIO_KEY = 'max_positive_negative_ratio'
+
+
+class ConfigKeyError(ValueError):
+    """Scientific/legacy config spelling refusal."""
+
+
+def _as_plain(config: Mapping[str, Any] | Any) -> dict:
+    if isinstance(config, dict):
+        return dict(config)
+    try:
+        return dict(config)
+    except Exception as exc:
+        raise ConfigKeyError('policy config is not a mapping') from exc
+
+
+def _require_positive_int(value, *, key: str) -> int:
+    if type(value) is bool or type(value) is not int:
+        raise ConfigKeyError(f'{key} must be an exact positive int')
+    if value < 1:
+        raise ConfigKeyError(f'{key} must be an exact positive int')
+    return value
+
+
+def resolve_max_pos_neg_ratio(config, *, scientific: bool = False) -> int:
+    """Honor only `max_pos_neg_ratio`. The long name never silently applies.
+
+    Scientific route: the canonical key is required.
+    Legacy route: missing key keeps the historical default 10, but the yaml
+    key `max_pos_neg_ratio` is read when present (removing the proven mismatch).
+    Present values must be exact positive ints: bool/float/string/zero/negative
+    are refused on both routes.
+    """
+    cfg = _as_plain(config)
+    if FORBIDDEN_MAX_POS_NEG_RATIO_KEY in cfg:
+        raise ConfigKeyError(
+            f'{FORBIDDEN_MAX_POS_NEG_RATIO_KEY} is not a valid key; '
+            f'use {CANONICAL_MAX_POS_NEG_RATIO_KEY}'
+        )
+    has_canonical = CANONICAL_MAX_POS_NEG_RATIO_KEY in cfg
+    if scientific:
+        if not has_canonical:
+            raise ConfigKeyError(
+                f'{CANONICAL_MAX_POS_NEG_RATIO_KEY} is required on the scientific route'
+            )
+        return _require_positive_int(
+            cfg[CANONICAL_MAX_POS_NEG_RATIO_KEY], key=CANONICAL_MAX_POS_NEG_RATIO_KEY)
+    if has_canonical:
+        return _require_positive_int(
+            cfg[CANONICAL_MAX_POS_NEG_RATIO_KEY], key=CANONICAL_MAX_POS_NEG_RATIO_KEY)
+    return 10
