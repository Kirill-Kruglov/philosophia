+#!/usr/bin/env python3
+"""Isolated-process jobs with file IPC. Parent owns the wall deadline.
+
+A bounded pipe is never used to carry the result. The child writes an atomic
+result file; the parent polls liveness until the deadline, then reads the file
+or SIGKILLs the worker. A successful large payload cannot be misclassified as
+a timeout.
+
+String-only Peano enumeration is test-only. Production Peano search runs as a
+whole-item job in phase2_isolated.
+"""
+
+from __future__ import annotations
+
+import math
+import multiprocessing as mp
+import os
+import pickle
+import shutil
+import signal
+import tempfile
+import time
+from typing import Any
+
+
+class IsolatedInvalidTimeout(ValueError):
+    """Wall deadline is not a positive finite int or float."""
+
+    def __init__(self, message: str = 'timeout_s must be a positive finite number'):
+        self.message = str(message)
+        super().__init__(self.message)
+
+
+def require_positive_finite_timeout(timeout_s) -> float:
+    """Reject bool, non-numeric, non-finite, zero, and negative deadlines."""
+    if type(timeout_s) is bool or type(timeout_s) not in (int, float):
+        raise IsolatedInvalidTimeout(
+            'timeout_s must be a positive finite int or float'
+        )
+    value = float(timeout_s)
+    if not math.isfinite(value) or value <= 0:
+        raise IsolatedInvalidTimeout(
+            'timeout_s must be a positive finite number'
+        )
+    return value
+
+
+class IsolatedJobTimeout(RuntimeError):
+    def __init__(self, elapsed_s: float, timeout_s: float):
+        self.elapsed_s = float(elapsed_s)
+        self.timeout_s = float(timeout_s)
+        super().__init__(
+            f'isolated job timeout elapsed={self.elapsed_s:.6f}s '
+            f'limit={self.timeout_s:.6f}s'
+        )
+
+
+class IsolatedEnumerationTimeout(IsolatedJobTimeout):
+    """Typed timeout for the test-only string enumeration helper."""
+
+
+class IsolatedItemTimeout(IsolatedJobTimeout):
+    """Typed timeout for the whole formal-item scientific worker."""
+
+
+class IsolatedJobError(RuntimeError):
+    """Child exited without a successful result, or the error envelope is unusable."""
+
+    def __init__(
+            self,
+            message: str,
+            *,
+            envelope: dict | None = None,
+            code: str | None = None,
+            exception_class: str | None = None,
+    ):
+        super().__init__(message)
+        self.envelope = envelope
+        self.code = code
+        self.exception_class = exception_class
+
+
+class IsolatedChildCrash(IsolatedJobError):
+    """Child terminated without an atomically installed result file."""
+
+    def __init__(self, exitcode):
+        self.exitcode = exitcode
+        super().__init__(
+            f'isolated child crash exit {exitcode} wrote no result',
+            exception_class='IsolatedChildCrash',
+        )
+
+
+def execute_enumeration_job_test_only(job: tuple) -> list:
+    """Test-only string materializer. Not the production Peano search path.
+
+    Production search reconstructs PyProofState inside the whole-item worker
+    and never returns action objects or action strings for parent expansion.
+    """
+    kind = job[0]
+    if kind == 'never_return':
+        while True:
+            time.sleep(60)
+    if kind == 'explicit':
+        return list(job[1])
+    if kind in ('peano', 'peano_strings_test_only'):
+        theory, premises, goal = job[1], list(job[2]), job[3]
+        import peano
+        state = peano.PyProofState(theory, premises, goal)
+        return [str(action) for action in state.actions()]
+    raise ValueError(f'unknown enumeration job {kind!r}')
+
+
+# Backward-compatible alias; callers must treat this as test-only.
+execute_enumeration_job = execute_enumeration_job_test_only
+
+
+def execute_isolated_job(job: Any) -> Any:
+    """Run only in the child process."""
+    if isinstance(job, tuple):
+        return execute_enumeration_job_test_only(job)
+    if not isinstance(job, dict):
+        raise ValueError(f'unknown isolated job type {type(job)!r}')
+    kind = job.get('kind')
+    if kind == 'never_return':
+        while True:
+            time.sleep(60)
+    if kind == 'echo':
+        return job['payload']
+    if kind == 'internal_error_test_only':
+        raise RuntimeError('injected internal worker failure')
+    if kind == 'malformed_envelope_test_only':
+        raise RuntimeError('placeholder; child main emits a malformed envelope')
+    if kind == 'crash_no_result_test_only':
+        os._exit(3)
+    if kind == 'scientific_item':
+        from phase2_isolated import run_scientific_item_in_worker
+        return run_scientific_item_in_worker(job)
+    raise ValueError(f'unknown isolated job {kind!r}')
+
+
+def _isolated_child_main(result_path: str, job: Any) -> None:
+    tmp_path = result_path + '.tmp'
+    try:
+        if isinstance(job, dict) and job.get('kind') == 'malformed_envelope_test_only':
+            blob = ('err', {'code': 'QUERY_OVERFLOW', 'kind': 'action'})
+        else:
+            payload = execute_isolated_job(job)
+            blob = ('ok', payload)
+    except BaseException as exc:
+        if type(exc) in (SystemExit, KeyboardInterrupt, GeneratorExit):
+            raise
+        if isinstance(job, dict) and job.get('kind') in (
+                'scientific_item',
+                'internal_error_test_only',
+        ):
+            from phase2_isolated import scientific_error_envelope
+            blob = ('err', scientific_error_envelope(exc))
+        elif isinstance(exc, Exception):
+            blob = ('err', (type(exc).__name__, str(exc)))
+        else:
+            blob = ('err', (type(exc).__name__, str(exc)))
+    try:
+        with open(tmp_path, 'wb') as handle:
+            pickle.dump(blob, handle, protocol=pickle.HIGHEST_PROTOCOL)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(tmp_path, result_path)
+    except Exception:
+        try:
+            if os.path.exists(tmp_path):
+                os.remove(tmp_path)
+        except OSError:
+            pass
+        raise
+
+
+def _kill_process(proc: mp.Process) -> None:
+    if proc.pid is None:
+        return
+    if proc.is_alive():
+        proc.kill()
+    proc.join(1.0)
+    if proc.is_alive():
+        os.kill(proc.pid, signal.SIGKILL)
+        proc.join(1.0)
+
+
+def run_isolated_job(job: Any, timeout_s: float) -> Any:
+    """Run `job` in a spawn child. Drain via a result file, never join-before-recv."""
+    timeout_s = require_positive_finite_timeout(timeout_s)
+    ctx = mp.get_context('spawn')
+    tmpdir = tempfile.mkdtemp(prefix='phase2_isolated_')
+    result_path = os.path.join(tmpdir, 'result.pkl')
+    proc = ctx.Process(
+        target=_isolated_child_main,
+        args=(result_path, job),
+        daemon=True,
+    )
+    start = time.monotonic()
+    try:
+        proc.start()
+        deadline = start + timeout_s
+        while proc.is_alive():
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                break
+            proc.join(min(0.05, remaining))
+        elapsed = time.monotonic() - start
+        if os.path.exists(result_path):
+            with open(result_path, 'rb') as handle:
+                status, payload = pickle.load(handle)
+            if proc.is_alive():
+                _kill_process(proc)
+        elif proc.is_alive():
+            _kill_process(proc)
+            raise IsolatedJobTimeout(elapsed, timeout_s)
+        else:
+            raise IsolatedChildCrash(proc.exitcode)
+    finally:
+        shutil.rmtree(tmpdir, ignore_errors=True)
+        if proc.is_alive():
+            _kill_process(proc)
+    if status == 'err':
+        if isinstance(payload, dict):
+            raise IsolatedJobError(
+                'isolated child returned an error envelope',
+                envelope=payload,
+                code=payload.get('code') if isinstance(payload.get('code'), str) else None,
+            )
+        name, message = payload
+        raise IsolatedJobError(f'isolated child {name}: {message}')
+    return payload
+
+
+def run_interruptible_enumeration(job: tuple, timeout_s: float) -> list:
+    """Test-only string enumeration helper using the same file-IPC worker."""
+    try:
+        return list(run_isolated_job(job, timeout_s))
+    except IsolatedJobTimeout as exc:
+        raise IsolatedEnumerationTimeout(exc.elapsed_s, exc.timeout_s) from exc
