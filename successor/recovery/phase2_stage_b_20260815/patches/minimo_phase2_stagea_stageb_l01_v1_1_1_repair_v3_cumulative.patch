+    def test_two_class_softmax_preserves_float32_and_float64(self):
+        for dtype in (torch.float32, torch.float64):
+            with self.subTest(dtype=str(dtype)):
+                pos_in = torch.tensor(1000.0, dtype=dtype)
+                neg_in = torch.tensor(-1000.0, dtype=dtype)
+                pos = two_class_positive_probability(pos_in, neg_in)
+                neg = two_class_positive_probability(neg_in, pos_in)
+                self.assertEqual(pos.dtype, dtype)
+                self.assertEqual(neg.dtype, dtype)
+                self.assertTrue(torch.isfinite(pos))
+                self.assertTrue(torch.isfinite(neg))
+                self.assertGreater(float(pos), 0.99)
+                self.assertLess(float(neg), 0.01)
