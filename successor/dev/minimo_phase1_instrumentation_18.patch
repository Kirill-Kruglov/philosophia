+    elif problemset_id in (
+        'kleene',
+        'propositional-logic-extrinsic',
+        'kleene-propositional-logic',
+    ):
+        return load_kleene_propositional_logic_extrinsic()
     raise ValueError(f'Unknown problem set {problemset_id}')
