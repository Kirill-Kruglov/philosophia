+                    self.assertIn(alias.name.split('.')[0],
+                                  ALLOWED_IMPORT_MODULES, alias.name)
+            elif isinstance(node, ast.ImportFrom):
+                self.assertEqual(node.level, 0)
+                self.assertIn((node.module or '').split('.')[0],
+                              ALLOWED_IMPORT_MODULES, node.module)
