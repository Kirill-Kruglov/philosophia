+        return False
+    if kind == 'NOT':
+        return not test_eval_formula(formula['arg'], nu)
+    if kind == 'AND':
+        return (
+            test_eval_formula(formula['left'], nu)
+            and test_eval_formula(formula['right'], nu)
+        )
+    return (
+        test_eval_formula(formula['left'], nu)
+        or test_eval_formula(formula['right'], nu)
+    )
