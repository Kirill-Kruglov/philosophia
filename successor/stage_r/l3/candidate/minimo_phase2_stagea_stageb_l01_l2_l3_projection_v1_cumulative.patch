+#!/usr/bin/env python3
+"""Production scientific search root: LM + codec + canonical expand + MCTS."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Mapping
+
+from phase2_actions import (
+    UncontainedPeanoError,
+    _WHOLE_ITEM_WORKER_CAPABILITY,
+    refuse_uncontained_peano,
+    whole_item_worker_capability_granted,
+)
+from phase2_policy import ScientificLMPolicy
+from phase2_search import ScientificMonteCarloTreeSearch
+from phase2_timeout import require_positive_finite_timeout
+
+
+def run_isolated_scientific_item(*args, **kwargs):
+    from phase2_isolated import run_isolated_scientific_item as _run
+    return _run(*args, **kwargs)
+
+
+@dataclass
+class ScientificSearchRoot:
+    policy: ScientificLMPolicy
+    search: ScientificMonteCarloTreeSearch
+    spec: dict
+
+    def run(self, root_node, *, start_index: int = 0):
+        if not isinstance(self.policy, ScientificLMPolicy):
+            raise TypeError('scientific root policy must be ScientificLMPolicy')
+        if type(self.search._default_policy) is not ScientificLMPolicy:
+            raise TypeError('search default policy is not the scientific LM policy')
+        refuse_uncontained_peano(root_node, self.search._worker_capability)
+        return self.search.evaluate(root_node, start_index=start_index, verbose=False)
+
+
+def make_scientific_search_root(
+        spec: Mapping,
+        *,
+        budget: int,
+        artifact_id: str = 'item',
+        action_timeout_s: float = 0.2,
+        value_prior_weight: float = 1.0,
+) -> ScientificSearchRoot:
+    """Public scientific search factory. Always rejects real Peano TreeSearchNode."""
+    timeout_s = require_positive_finite_timeout(action_timeout_s)
+    return _construct_scientific_search_root(
+        spec,
+        budget=budget,
+        artifact_id=artifact_id,
+        action_timeout_s=timeout_s,
+        value_prior_weight=value_prior_weight,
+        worker_capability=None,
+    )
+
+
+def _make_scientific_search_root_for_whole_item_worker(
+        spec: Mapping,
+        *,
+        budget: int,
+        artifact_id: str,
+        capability,
+        value_prior_weight: float = 1.0,
+) -> ScientificSearchRoot:
+    """Internal factory. Requires the identity-checked in-tree call-graph marker.
+
+    The marker is not a Python security capability.
+    """
+    if not whole_item_worker_capability_granted(capability):
+        raise UncontainedPeanoError(
+            'internal whole-item worker factory requires the module-private capability'
+        )
+    return _construct_scientific_search_root(
+        spec,
+        budget=budget,
+        artifact_id=artifact_id,
+        action_timeout_s=None,
+        value_prior_weight=value_prior_weight,
+        worker_capability=_WHOLE_ITEM_WORKER_CAPABILITY,
+    )
+
+
+def _construct_scientific_search_root(
+        spec: Mapping,
+        *,
+        budget: int,
+        artifact_id: str,
+        action_timeout_s: float | None,
+        value_prior_weight: float,
+        worker_capability,
+) -> ScientificSearchRoot:
+    policy = ScientificLMPolicy.from_spec(spec, value_prior_weight=value_prior_weight)
+    search_kwargs = {
+        'codec': policy.codec,
+        'artifact_id': artifact_id,
+        'use_policy': True,
+        'worker_capability': worker_capability,
+    }
+    if not whole_item_worker_capability_granted(worker_capability):
+        search_kwargs['action_timeout_s'] = action_timeout_s
+    search = ScientificMonteCarloTreeSearch(policy, budget=budget, **search_kwargs)
+    return ScientificSearchRoot(policy=policy, search=search, spec=policy.spec)
