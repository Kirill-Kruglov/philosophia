diff --git a/learning/phase2_isolated.py b/learning/phase2_isolated.py
new file mode 100644
index 0000000..172053d
--- /dev/null
+++ b/learning/phase2_isolated.py
@@ -0,0 +1,546 @@
+#!/usr/bin/env python3
+"""Public isolated scientific entry: whole formal-item search in one worker.
+
+Semantic PyProofAction / ProofAction / PyProofState objects never cross the
+process boundary. The parent receives only JSON-primitive evidence records.
+
+Whole-item refusals cross the boundary as a closed primitive error envelope.
+The parent reconstructs named typed exceptions from envelope fields, never by
+parsing human-readable strings. The parent owns the single wall deadline
+`timeout_s`.
+"""
+
+from __future__ import annotations
+
+import json
+from typing import Any, Mapping
+
+from phase2_actions import (
+    ActionHandlingError,
+    ArtifactIdLimitRefusal,
+    DuplicateActionSerialization,
+    ItemQueryOverflowRefusal,
+    PeanoPanicRefusal,
+    is_pyo3_panic,
+)
+from phase2_codec import (
+    ARTIFACT_ID_MAX_BYTES,
+    QUERY_KINDS,
+    ArtifactIdError,
+    QueryOverflow,
+    QueryOverflowError,
+    validate_artifact_id,
+)
+from phase2_spec import ScientificSpecError, canonical_spec_dict, reject_unavailable_device
+from phase2_timeout import IsolatedItemTimeout, IsolatedJobError, IsolatedJobTimeout, run_isolated_job
+
+
+BOUNDED_MESSAGE_LIMIT = 256
+DESCRIPTOR_KEYS = ('theory_text', 'premises', 'goal')
+PRODUCTION_JOB_KEYS = ('kind', 'descriptor', 'spec', 'budget', 'artifact_id')
+
+QUERY_OVERFLOW_KEYS = (
+    'code',
+    'item_artifact_id',
+    'kind',
+    'artifact_id',
+    'byte_count',
+    'token_count',
+    'limit',
+)
+DUPLICATE_ACTION_KEYS = ('code', 'serialization')
+ACTION_HANDLING_KEYS = ('code', 'message')
+INVALID_DESCRIPTOR_KEYS = ('code', 'message')
+INVALID_SPEC_KEYS = ('code', 'message')
+INTERNAL_ERROR_KEYS = ('code', 'exception_class', 'message')
+ARTIFACT_ID_LIMIT_KEYS = ('code', 'prefix', 'byte_count', 'limit')
+PEANO_PANIC_KEYS = ('code', 'exception_module', 'exception_class', 'message')
+
+ENVELOPE_KEY_SETS = {
+    'QUERY_OVERFLOW': QUERY_OVERFLOW_KEYS,
+    'DUPLICATE_ACTION_SERIALIZATION': DUPLICATE_ACTION_KEYS,
+    'ACTION_HANDLING_REFUSAL': ACTION_HANDLING_KEYS,
+    'INVALID_DESCRIPTOR': INVALID_DESCRIPTOR_KEYS,
+    'INVALID_SPEC': INVALID_SPEC_KEYS,
+    'INTERNAL_ERROR': INTERNAL_ERROR_KEYS,
+    'ARTIFACT_ID_LIMIT': ARTIFACT_ID_LIMIT_KEYS,
+    'PEANO_PANIC': PEANO_PANIC_KEYS,
+}
+
+
+class IsolatedInvalidDescriptor(ValueError):
+    """Descriptor for a whole scientific item is not a closed mapping of strings."""
+
+    def __init__(self, message: str):
+        self.message = str(message)
+        super().__init__(self.message)
+
+
+class IsolatedInvalidSpec(ValueError):
+    """Scientific spec refused before isolated search."""
+
+    def __init__(self, message: str):
+        self.message = str(message)
+        super().__init__(self.message)
+
+
+def _bounded_message(text: object, limit: int = BOUNDED_MESSAGE_LIMIT) -> str:
+    raw = str(text).encode('ascii', 'replace').decode('ascii')
+    if len(raw) > limit:
+        return raw[:limit]
+    return raw
+
+
+def _require_str(value: object, field: str) -> str:
+    if type(value) is not str:
+        raise IsolatedJobError(f'malformed error envelope: {field} must be str')
+    return value
+
+
+def _require_int(value: object, field: str) -> int:
+    if type(value) is not int:
+        raise IsolatedJobError(f'malformed error envelope: {field} must be int')
+    return value
+
+
+def _require_non_negative_int(value: object, field: str) -> int:
+    number = _require_int(value, field)
+    if number < 0:
+        raise IsolatedJobError(f'malformed error envelope: {field} must be non-negative')
+    return number
+
+
+def _require_artifact_id(value: object, field: str) -> str:
+    try:
+        return validate_artifact_id(value)
+    except ArtifactIdError as exc:
+        raise IsolatedJobError(
+            f'malformed error envelope: {field} is not a valid artifact id'
+        ) from exc
+
+
+def scientific_error_envelope(exc: BaseException) -> dict:
+    """Closed JSON-primitive error envelope. Never includes action objects."""
+    if isinstance(exc, ItemQueryOverflowRefusal):
+        record = exc.overflow.record
+        return {
+            'code': 'QUERY_OVERFLOW',
+            'item_artifact_id': str(exc.artifact_id),
+            'kind': str(record.kind),
+            'artifact_id': str(record.artifact_id),
+            'byte_count': int(record.byte_count),
+            'token_count': int(record.token_count),
+            'limit': int(record.limit),
+        }
+    if isinstance(exc, QueryOverflowError):
+        record = exc.record
+        return {
+            'code': 'QUERY_OVERFLOW',
+            'item_artifact_id': str(record.artifact_id),
+            'kind': str(record.kind),
+            'artifact_id': str(record.artifact_id),
+            'byte_count': int(record.byte_count),
+            'token_count': int(record.token_count),
+            'limit': int(record.limit),
+        }
+    if isinstance(exc, DuplicateActionSerialization):
+        return {
+            'code': 'DUPLICATE_ACTION_SERIALIZATION',
+            'serialization': str(exc.serialization),
+        }
+    if isinstance(exc, ArtifactIdLimitRefusal):
+        return {
+            'code': 'ARTIFACT_ID_LIMIT',
+            'prefix': str(exc.prefix),
+            'byte_count': int(exc.byte_count),
+            'limit': int(exc.limit),
+        }
+    if isinstance(exc, PeanoPanicRefusal) or is_pyo3_panic(exc):
+        if isinstance(exc, PeanoPanicRefusal):
+            module = exc.exception_module
+            cls_name = exc.exception_class
+            message = _bounded_message(exc)
+        else:
+            module = type(exc).__module__
+            cls_name = type(exc).__name__
+            message = _bounded_message(exc)
+        return {
+            'code': 'PEANO_PANIC',
+            'exception_module': _bounded_message(module),
+            'exception_class': _bounded_message(cls_name),
+            'message': message,
+        }
+    if isinstance(exc, IsolatedInvalidDescriptor):
+        return {
+            'code': 'INVALID_DESCRIPTOR',
+            'message': _bounded_message(exc.message),
+        }
+    if isinstance(exc, (IsolatedInvalidSpec, ScientificSpecError)):
+        return {
+            'code': 'INVALID_SPEC',
+            'message': _bounded_message(exc),
+        }
+    if isinstance(exc, ActionHandlingError):
+        return {
+            'code': 'ACTION_HANDLING_REFUSAL',
+            'message': _bounded_message(exc),
+        }
+    return {
+        'code': 'INTERNAL_ERROR',
+        'exception_class': type(exc).__name__,
+        'message': _bounded_message(exc),
+    }
+
+
+def raise_from_scientific_error_envelope(envelope: object) -> None:
+    """Validate exact keys/types and raise the named typed exception. Does not return."""
+    if not isinstance(envelope, dict):
+        raise IsolatedJobError('malformed error envelope: not a mapping')
+    code = envelope.get('code')
+    if type(code) is not str or code not in ENVELOPE_KEY_SETS:
+        raise IsolatedJobError('malformed error envelope: unknown or missing code')
+    expected = ENVELOPE_KEY_SETS[code]
+    if frozenset(envelope.keys()) != frozenset(expected):
+        raise IsolatedJobError('malformed error envelope: key set mismatch')
+    if code == 'QUERY_OVERFLOW':
+        kind = _require_str(envelope['kind'], 'kind')
+        if kind not in QUERY_KINDS:
+            raise IsolatedJobError('malformed error envelope: kind is not a codec query kind')
+        item_id = _require_artifact_id(envelope['item_artifact_id'], 'item_artifact_id')
+        artifact_id = _require_artifact_id(envelope['artifact_id'], 'artifact_id')
+        byte_count = _require_non_negative_int(envelope['byte_count'], 'byte_count')
+        token_count = _require_non_negative_int(envelope['token_count'], 'token_count')
+        limit = _require_non_negative_int(envelope['limit'], 'limit')
+        if token_count <= limit:
+            raise IsolatedJobError(
+                'malformed error envelope: QUERY_OVERFLOW requires token_count > limit'
+            )
+        if byte_count > token_count:
+            raise IsolatedJobError(
+                'malformed error envelope: byte_count must be <= token_count'
+            )
+        record = QueryOverflow(
+            kind=kind,
+            artifact_id=artifact_id,
+            byte_count=byte_count,
+            token_count=token_count,
+            limit=limit,
+        )
+        raise ItemQueryOverflowRefusal(item_id, QueryOverflowError(record))
+    if code == 'DUPLICATE_ACTION_SERIALIZATION':
+        raise DuplicateActionSerialization(
+            _require_str(envelope['serialization'], 'serialization'))
+    if code == 'ARTIFACT_ID_LIMIT':
+        prefix = _require_artifact_id(envelope['prefix'], 'prefix')
+        byte_count = _require_non_negative_int(envelope['byte_count'], 'byte_count')
+        limit = _require_non_negative_int(envelope['limit'], 'limit')
+        if limit != ARTIFACT_ID_MAX_BYTES:
+            raise IsolatedJobError('malformed error envelope: ARTIFACT_ID_LIMIT limit mismatch')
+        if byte_count <= limit:
+            raise IsolatedJobError(
+                'malformed error envelope: ARTIFACT_ID_LIMIT requires byte_count > limit'
+            )
+        raise ArtifactIdLimitRefusal(
+            attempted=prefix, byte_count=byte_count, limit=limit)
+    if code == 'PEANO_PANIC':
+        exception_module = _require_str(envelope['exception_module'], 'exception_module')
+        exception_class = _require_str(envelope['exception_class'], 'exception_class')
+        if exception_module != 'pyo3_runtime' or exception_class != 'PanicException':
+            raise IsolatedJobError(
+                'malformed error envelope: PEANO_PANIC requires '
+                'pyo3_runtime.PanicException'
+            )
+        raise PeanoPanicRefusal(
+            _require_str(envelope['message'], 'message'),
+            exception_module=exception_module,
+            exception_class=exception_class,
+        )
+    if code == 'ACTION_HANDLING_REFUSAL':
+        raise ActionHandlingError(_require_str(envelope['message'], 'message'))
+    if code == 'INVALID_DESCRIPTOR':
+        raise IsolatedInvalidDescriptor(_require_str(envelope['message'], 'message'))
+    if code == 'INVALID_SPEC':
+        raise IsolatedInvalidSpec(_require_str(envelope['message'], 'message'))
+    if code == 'INTERNAL_ERROR':
+        exception_class = _require_str(envelope['exception_class'], 'exception_class')
+        message = _require_str(envelope['message'], 'message')
+        raise IsolatedJobError(
+            f'isolated child INTERNAL_ERROR {exception_class}: {message}',
+            envelope=dict(envelope),
+            code='INTERNAL_ERROR',
+            exception_class=exception_class,
+        )
+    raise IsolatedJobError('malformed error envelope: unhandled code')
+
+
+def parse_item_descriptor(descriptor: object) -> tuple[str, list[str], str]:
+    """Closed descriptor: exact keys and exact field types. Never KeyError."""
+    if not isinstance(descriptor, Mapping):
+        raise IsolatedInvalidDescriptor('descriptor must be a mapping')
+    extra = [key for key in descriptor.keys() if key not in DESCRIPTOR_KEYS]
+    missing = [key for key in DESCRIPTOR_KEYS if key not in descriptor]
+    if missing or extra:
+        raise IsolatedInvalidDescriptor(
+            f'descriptor must contain exactly {list(DESCRIPTOR_KEYS)}; '
+            f'missing={missing} extra={extra}'
+        )
+    theory = descriptor['theory_text']
+    premises = descriptor['premises']
+    goal = descriptor['goal']
+    if type(theory) is not str:
+        raise IsolatedInvalidDescriptor('theory_text must be a str')
+    if type(goal) is not str:
+        raise IsolatedInvalidDescriptor('goal must be a str')
+    if type(premises) not in (list, tuple):
+        raise IsolatedInvalidDescriptor('premises must be a list or tuple of str')
+    materialized = list(premises)
+    if any(type(item) is not str for item in materialized):
+        raise IsolatedInvalidDescriptor('premises must be a list or tuple of str')
+    return theory, materialized, goal
+
+
+def parse_item_spec(spec: object) -> dict:
+    """Closed scientific spec. Every ScientificSpecError becomes IsolatedInvalidSpec."""
+    try:
+        validated = canonical_spec_dict(spec)
+    except ScientificSpecError as exc:
+        raise IsolatedInvalidSpec(_bounded_message(exc)) from exc
+    reject_unavailable_device(validated['device'])
+    return validated
+
+
+def parse_budget(budget: object) -> int:
+    if type(budget) is bool or type(budget) is not int or budget < 0:
+        raise IsolatedInvalidDescriptor('budget must be an exact non-negative int')
+    return budget
+
+
+def parse_base_artifact_id(value: object) -> str:
+    try:
+        return validate_artifact_id(value)
+    except ArtifactIdError as exc:
+        raise IsolatedInvalidDescriptor(
+            'artifact_id must be a nonempty ASCII string of at most '
+            f'{ARTIFACT_ID_MAX_BYTES} bytes'
+        ) from exc
+
+
+def parse_scientific_item_job(job: object) -> tuple:
+    """Exact production job keys plus closed descriptor/spec/budget/artifact_id."""
+    if not isinstance(job, Mapping):
+        raise IsolatedInvalidDescriptor('job must be a mapping')
+    extra = [key for key in job.keys() if key not in PRODUCTION_JOB_KEYS]
+    missing = [key for key in PRODUCTION_JOB_KEYS if key not in job]
+    if missing or extra:
+        raise IsolatedInvalidDescriptor(
+            f'scientific item job must contain exactly {list(PRODUCTION_JOB_KEYS)}; '
+            f'missing={missing} extra={extra}'
+        )
+    if job.get('kind') != 'scientific_item':
+        raise IsolatedInvalidDescriptor("job kind must be 'scientific_item'")
+    theory, premises, goal = parse_item_descriptor(job['descriptor'])
+    spec = parse_item_spec(job['spec'])
+    budget = parse_budget(job['budget'])
+    artifact_id = parse_base_artifact_id(job['artifact_id'])
+    return theory, premises, goal, spec, budget, artifact_id
+
+
+def _learner_identity(policy) -> dict:
+    manifest = policy.bundle.manifest
+    return {
+        'learner_spec_hash': str(policy.bundle.spec_hash),
+        'state_dict_hash': str(manifest['state_dict_hash']),
+        'optimizer_state_hash': str(manifest['optimizer_state_hash']),
+    }
+
+
+def primitive_item_evidence(record, node, policy) -> dict:
+    """JSON-safe evidence. Action objects stay in this process."""
+    expansion = getattr(node, '_canonical_expansion', None)
+    entered = int(record.entered_tree_policy_iterations)
+    expansions = int(record.new_leaf_expansions)
+    identity = _learner_identity(policy)
+    if expansion is None:
+        if entered != 0 or expansions != 0:
+            raise RuntimeError('isolated item produced no canonical expansion')
+        empty = {
+            'entered_tree_policy_iterations': 0,
+            'new_leaf_expansions': 0,
+            'ordered_serializations': [],
+            'serializations_unique_sorted': True,
+            'action_object_types': [],
+            'action_objects_are_strings': False,
+            'peano_backed_proof_actions': False,
+            'children_constructed': False,
+            'children_initialized': False,
+            'action_queries_preflighted': False,
+            'value_queries_preflighted': False,
+            'n_policy_queries': 0,
+            'n_value_queries': 0,
+            'policy_class': type(policy).__name__,
+            'search_class': 'ScientificMonteCarloTreeSearch',
+            'scientific_expand_path': 'none',
+            'used_legacy_expand': False,
+            'used_max_action_length': False,
+            'used_transformer_lm_policy': False,
+            'used_lm_policy': False,
+            'reached_network_logger': False,
+            'reached_distributed_queue': False,
+            'canonical_record': json.loads(record.canonical_bytes().decode('ascii')),
+        }
+        empty.update(identity)
+        return empty
+    from action import ProofAction
+
+    ordered_actions = tuple(expansion.ordered_actions)
+    types = [type(action).__name__ for action in ordered_actions]
+    peano_backed = True
+    for action in ordered_actions:
+        if not isinstance(action, ProofAction):
+            peano_backed = False
+            break
+        inners = getattr(action, '_actions', None)
+        if not inners:
+            peano_backed = False
+            break
+        if any(type(inner).__name__ != 'PyProofAction' for inner in inners):
+            peano_backed = False
+            break
+    children = list(node._children or [])
+    initialized = bool(children) and all(
+        child._value_estimate is not None and child._prior_policy is not None
+        for child in children
+    )
+    serials = list(expansion.ordered_serializations)
+    evidence = {
+        'entered_tree_policy_iterations': entered,
+        'new_leaf_expansions': expansions,
+        'ordered_serializations': serials,
+        'serializations_unique_sorted': serials == sorted(set(serials)) and bool(serials),
+        'action_object_types': types,
+        'action_objects_are_strings': any(isinstance(action, str) for action in ordered_actions),
+        'peano_backed_proof_actions': peano_backed,
+        'children_constructed': bool(children) and len(children) == len(ordered_actions),
+        'children_initialized': initialized,
+        'action_queries_preflighted': bool(expansion.policy_queries),
+        'value_queries_preflighted': bool(expansion.value_queries),
+        'n_policy_queries': len(expansion.policy_queries),
+        'n_value_queries': len(expansion.value_queries),
+        'policy_class': type(policy).__name__,
+        'search_class': 'ScientificMonteCarloTreeSearch',
+        'scientific_expand_path': 'stage_children_from_actions',
+        'used_legacy_expand': False,
+        'used_max_action_length': False,
+        'used_transformer_lm_policy': False,
+        'used_lm_policy': False,
+        'reached_network_logger': False,
+        'reached_distributed_queue': False,
+        'canonical_record': json.loads(record.canonical_bytes().decode('ascii')),
+    }
+    evidence.update(identity)
+    return evidence
+
+
+def run_scientific_item_in_worker(job: Mapping[str, Any]) -> dict:
+    """Child-only: validate the job, then reconstruct real Peano state and search."""
+    theory, premises, goal, spec, budget, artifact_id = parse_scientific_item_job(job)
+    from phase2_actions import _WHOLE_ITEM_WORKER_CAPABILITY
+    from phase2_root import _make_scientific_search_root_for_whole_item_worker
+    import peano
+    from proofsearch import HolophrasmNode, TreeSearchNode
+
+    state = peano.PyProofState(theory, premises, goal)
+    node = TreeSearchNode(HolophrasmNode([state]))
+    root = _make_scientific_search_root_for_whole_item_worker(
+        spec,
+        budget=budget,
+        artifact_id=artifact_id,
+        capability=_WHOLE_ITEM_WORKER_CAPABILITY,
+    )
+    record, _pi, _value = root.run(node)
+    evidence = primitive_item_evidence(record, node, root.policy)
+    evidence['search_class'] = type(root.search).__name__
+    evidence['root_class'] = type(root).__name__
+    evidence['node_class'] = type(node).__name__
+    evidence['state_node_class'] = type(node.state_node).__name__
+    return evidence
+
+
+def make_scientific_item_job(
+        descriptor: Mapping[str, Any],
+        spec: Mapping[str, Any],
+        *,
+        budget: int,
+        artifact_id: str = 'item',
+) -> dict:
+    """Closed whole-item job envelope. No injection control or native timeout."""
+    theory, premises, goal = parse_item_descriptor(descriptor)
+    spec_dict = parse_item_spec(spec)
+    budget_value = parse_budget(budget)
+    artifact = parse_base_artifact_id(artifact_id)
+    job = {
+        'kind': 'scientific_item',
+        'descriptor': {
+            'theory_text': theory,
+            'premises': premises,
+            'goal': goal,
+        },
+        'spec': spec_dict,
+        'budget': budget_value,
+        'artifact_id': artifact,
+    }
+    if frozenset(job.keys()) != frozenset(PRODUCTION_JOB_KEYS):
+        raise IsolatedInvalidDescriptor('production job key set mismatch')
+    return job
+
+
+def _run_item_job(job: Mapping[str, Any], timeout_s: float) -> dict:
+    try:
+        return run_isolated_job(job, timeout_s)
+    except IsolatedJobTimeout as exc:
+        raise IsolatedItemTimeout(exc.elapsed_s, exc.timeout_s) from exc
+    except IsolatedJobError as exc:
+        if exc.envelope is None:
+            raise
+        raise_from_scientific_error_envelope(exc.envelope)
+        raise IsolatedJobError('error envelope did not raise')
+
+
+def run_isolated_scientific_item(
+        descriptor: Mapping[str, Any],
+        spec: Mapping[str, Any],
+        *,
+        budget: int,
+        timeout_s: float,
+        artifact_id: str = 'item',
+) -> dict:
+    """Public production entry: whole-item search in a killable worker.
+
+    `timeout_s` is the single parent-owned whole-item wall deadline.
+    Descriptor, spec, budget, artifact_id, and timeout are closed before spawn.
+    """
+    job = make_scientific_item_job(
+        descriptor,
+        spec,
+        budget=budget,
+        artifact_id=artifact_id,
+    )
+    return _run_item_job(job, timeout_s)
+
+
+def run_isolated_hang_test_only(timeout_s: float):
+    """Test-only hang on the same spawn/kill worker. Not a production input."""
+    try:
+        return run_isolated_job({'kind': 'never_return'}, timeout_s)
+    except IsolatedJobTimeout as exc:
+        raise IsolatedItemTimeout(exc.elapsed_s, exc.timeout_s) from exc
+
+
+def run_isolated_internal_error_test_only(timeout_s: float):
+    """Test-only unknown internal error through file IPC + envelope reconstruction."""
+    return _run_item_job({'kind': 'internal_error_test_only'}, timeout_s)
+
+
+def run_isolated_malformed_envelope_test_only(timeout_s: float):
+    """Test-only malformed overflow envelope through file IPC + reconstruction."""
+    return _run_item_job({'kind': 'malformed_envelope_test_only'}, timeout_s)
