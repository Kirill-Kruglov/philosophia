+            with self.assertRaises(ScientificDeviceUnavailable):
+                construct_scientific_lm(spec)
+
+    def test_legacy_constructor_still_branches_on_cuda(self):
+        source = (LEARNING_DIR / 'policy.py').read_text(encoding='utf-8')
+        legacy = source.split('def make_scientific_policy')[0]
+        self.assertIn('torch.cuda.is_available()', legacy)
+        self.assertIn('n_layer=2', legacy)
+
+    def test_scientific_route_is_distinct(self):
+        self.assertTrue(hasattr(policy, 'make_scientific_policy'))
+
+    def test_load_accepts_matching_manifest(self):
+        spec = tiny_scientific_spec()
+        bundle = construct_scientific_lm(spec)
+        blob = {
+            'manifest': bundle.manifest,
+            'model_state_dict': bundle.model.state_dict(),
+            'optimizer_state_dict': bundle.optimizer.state_dict(),
