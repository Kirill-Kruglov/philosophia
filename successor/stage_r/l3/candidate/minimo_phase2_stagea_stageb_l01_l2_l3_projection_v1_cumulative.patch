+        left_bytes = canonical_bytes(mid['left'])
+        if left_bytes == canonical_bytes(field1):
+            field2 = mid['right']
+        else:
+            field2 = mid['left']
+    return (
+        formula_leaves(field1),
+        len(formula_atoms(field1)),
+        formula_leaves(field2),
