+#!/usr/bin/env python3
+"""Scientific LM policy: exact codec, search initialize/evaluate, no network logging."""
+
+from __future__ import annotations
+
+from typing import Mapping, Sequence
+
+import numpy as np
+import torch
+
+from phase2_codec import QueryCodec, QueryCodecError, validate_artifact_id
+from phase2_spec import ScientificLanguageModel, construct_scientific_lm
+
+
+def two_class_log_softmax(pos_logit: torch.Tensor, neg_logit: torch.Tensor) -> torch.Tensor:
+    """Stable two-class log-softmax in the logits' original declared dtype."""
+    if pos_logit.dtype != neg_logit.dtype:
+        raise TypeError(
+            f'logit dtypes must match: {pos_logit.dtype} vs {neg_logit.dtype}'
+        )
+    stacked = torch.stack((pos_logit, neg_logit), dim=-1)
+    return torch.log_softmax(stacked, dim=-1)
+
+
+def two_class_positive_probability(pos_logit: torch.Tensor, neg_logit: torch.Tensor) -> torch.Tensor:
+    """Finite P(positive) from Y/N logits. Survives +/-1000 logits."""
+    return two_class_log_softmax(pos_logit, neg_logit)[..., 0].exp()
+
+
+class ScientificSamplingForbidden(RuntimeError):
+    """Scientific route must not sample from a mutable global RNG."""
+
+
+def payload_answer_index(token_count: int) -> int:
+    """Index of the last payload token. Logits there predict Y/N, not post-EOS."""
+    if token_count < 2:
+        raise QueryCodecError('sequence too short for Y/N logits')
+    return int(token_count) - 2
+
+
+class ScientificLMPolicy:
+    def __init__(
+            self,
+            bundle: ScientificLanguageModel,
+            codec: QueryCodec,
+            *,
+            value_prior_weight: float = 1.0,
+    ):
+        self.bundle = bundle
+        self.codec = codec
+        self.model = bundle.model
+        self.optimizer = bundle.optimizer
+        self.spec = bundle.spec
+        self._value_prior_weight = float(value_prior_weight)
+        self.model.eval()
+
+    @classmethod
+    def from_spec(cls, spec: Mapping, *, value_prior_weight: float = 1.0) -> 'ScientificLMPolicy':
+        bundle = construct_scientific_lm(spec)
+        codec = QueryCodec(
+            n_positions=bundle.spec['n_positions'],
+            bos_token_id=bundle.spec['bos_token_id'],
+            eos_token_id=bundle.spec['eos_token_id'],
+            pad_token_id=bundle.spec['pad_token_id'],
+            vocab_size=bundle.spec['vocab_size'],
+        )
+        return cls(bundle, codec, value_prior_weight=value_prior_weight)
+
+    def eval(self):
+        self.model.eval()
+        return self
+
+    def parameters(self):
+        return self.model.parameters()
+
+    def preflight_training_batch(self, examples: Sequence[str]):
+        return self.codec.preflight_training_batch(examples)
+
+    def gradient_step(self, examples: Sequence[str]) -> float:
+        encoded = self.preflight_training_batch(examples)
+        device = next(self.model.parameters()).device
+        token_ids, lengths = self.codec.pad_batch(encoded, device=device)
+        labels = token_ids.clone()
+        labels[labels == self.codec.pad_token_id] = -100
+        attn_mask = token_ids != self.codec.pad_token_id
+        self.model.train()
+        self.optimizer.zero_grad()
+        loss = self.model(
+            token_ids, attention_mask=attn_mask, labels=labels
+        ).loss
+        loss.backward()
+        self.optimizer.step()
+        self.model.eval()
+        return float(loss.item())
+
+    def estimate_encoded_values(self, encoded) -> np.ndarray:
+        if not encoded:
+            return np.array([], dtype=np.float64)
+        device = next(self.model.parameters()).device
+        token_ids, lengths = self.codec.pad_batch(encoded, device=device)
+        attn_mask = token_ids != self.codec.pad_token_id
+        with torch.no_grad():
+            out = self.model(token_ids, attention_mask=attn_mask)
+        answer_idx = [payload_answer_index(length) for length in lengths]
+        last_preds = out.logits[
+            torch.arange(len(encoded), device=device),
+            torch.tensor(answer_idx, device=device),
+            :,
+        ]
+        pos_logit = last_preds[:, ord('Y')]
+        neg_logit = last_preds[:, ord('N')]
+        vs = two_class_positive_probability(pos_logit, neg_logit)
+        return vs.detach().cpu().numpy()
+
+    def estimate_query_values(
+            self,
+            texts: Sequence[str],
+            *,
+            kind: str = 'value',
+            artifact_ids: Sequence[str] | None = None,
+    ) -> np.ndarray:
+        snapshot = tuple(texts)
+        if artifact_ids is not None:
+            ids = tuple(validate_artifact_id(item) for item in artifact_ids)
+        else:
+            ids = tuple(
+                validate_artifact_id(f'{kind}:{i}') for i in range(len(snapshot))
+            )
+        encoded = self.codec.encode_queries(
+            snapshot,
+            kind=kind,
+            artifact_ids=ids,
+        )
+        if tuple(texts) != snapshot:
+            raise RuntimeError('scientific value encode mutated caller list')
+        return self.estimate_encoded_values(encoded)
+
+    def estimate_state_values(self, states: list[str]) -> np.ndarray:
+        snapshot = tuple(states)
+        queries = [self.codec.format_state_query(state) for state in snapshot]
+        if tuple(states) != snapshot:
+            raise RuntimeError('scientific state format mutated caller list')
+        return self.estimate_query_values(
+            queries,
+            kind='value',
+            artifact_ids=tuple(
+                validate_artifact_id(f'value:{i}') for i in range(len(snapshot))
+            ),
+        )
+
+    def estimate_state_action_values(self, state: str, actions: list[str]) -> np.ndarray:
+        snapshot = tuple(actions)
+        queries = [self.codec.format_action_query(state, action) for action in snapshot]
+        if tuple(actions) != snapshot:
+            raise RuntimeError('scientific action format mutated caller list')
+        return self.estimate_query_values(
+            queries,
+            kind='action',
+            artifact_ids=tuple(
+                validate_artifact_id(f'action:{i}') for i in range(len(snapshot))
+            ),
+        )
+
+    def estimate_state_and_action_values(
+            self,
+            state: str,
+            actions: list[str],
+            children: list[str],
+    ) -> tuple[np.ndarray, np.ndarray]:
+        """Return (action-prior scores, child-state values) for initialize."""
+        sa_snapshot = tuple(actions)
+        st_snapshot = tuple(children)
+        sa_queries = [self.codec.format_action_query(state, action) for action in sa_snapshot]
+        st_queries = [self.codec.format_state_query(child) for child in st_snapshot]
+        sa_ans = self.estimate_query_values(
+            sa_queries,
+            kind='action',
+            artifact_ids=tuple(
+                validate_artifact_id(f'action:{i}') for i in range(len(sa_snapshot))
+            ),
+        )
+        st_ans = self.estimate_query_values(
+            st_queries,
+            kind='value',
+            artifact_ids=tuple(
+                validate_artifact_id(f'child:{i}') for i in range(len(st_snapshot))
+            ),
+        )
+        if tuple(actions) != sa_snapshot or tuple(children) != st_snapshot:
+            raise RuntimeError('scientific initialize encode mutated caller lists')
+        return sa_ans, st_ans
+
+    def initialize(self, node) -> None:
+        if node.is_terminal() or node.is_dead():
+            return
+        children = node._children or []
+        if not children:
+            return
+        children_states = [str(c.state_node) for c in children]
+        actions = [str(a) for a in node.actions]
+        policy_estimates, value_estimates = self.estimate_state_and_action_values(
+            str(node.state_node),
+            actions,
+            children_states,
+        )
+        if node.is_conjunctive():
+            policy_estimates = np.ones(len(actions), dtype=np.float64)
+        denom = float(np.sum(policy_estimates))
+        if denom == 0:
+            priors = np.ones(len(actions), dtype=np.float64) / max(1, len(actions))
+        else:
+            priors = np.asarray(policy_estimates, dtype=np.float64) / denom
+        for child, value, prior in zip(children, value_estimates, priors):
+            child._reward = float(value) * self._value_prior_weight
+            child._value_estimate = float(value)
+            child._prior_policy = float(prior)
+        values = self.estimate_state_values([str(node.state_node)])
+        node._value_estimate = float(values[0])
+
+    def evaluate(self, node):
+        if node.is_terminal():
+            return [], 1e6
+        children = node._children or []
+        priors = [c._prior_policy for c in children]
+        if node._value_estimate is None:
+            values = self.estimate_state_values([str(node.state_node)])
+            node._value_estimate = float(values[0])
+        return priors, node._value_estimate
+
+    def completion_logprob(
+            self,
+            preambles: Sequence[str],
+            completions: Sequence[str],
+    ) -> list[float]:
+        p_snap = tuple(preambles)
+        c_snap = tuple(completions)
+        if len(p_snap) != len(c_snap):
+            raise ValueError('preambles and completions must have equal length')
+        texts = [p + c for p, c in zip(p_snap, c_snap)]
+        encoded = self.codec.encode_queries(
+            texts,
+            kind='completion',
+            artifact_ids=tuple(
+                validate_artifact_id(f'completion:{i}') for i in range(len(texts))
+            ),
+        )
+        device = next(self.model.parameters()).device
+        token_ids, _lengths = self.codec.pad_batch(encoded, device=device)
+        attn_mask = token_ids != self.codec.pad_token_id
+        with torch.no_grad():
+            out = self.model(token_ids, attention_mask=attn_mask)
+        p_lens = [len(p.encode('ascii')) for p in p_snap]
+        c_lens = [len(c.encode('ascii')) for c in c_snap]
+        result = self.codec.completion_logprobs_from_logits(
+            out.logits, token_ids, p_lens, c_lens, bos=True, eos=True
+        )
+        if tuple(preambles) != p_snap or tuple(completions) != c_snap:
+            raise RuntimeError('scientific completion mutated caller lists')
+        return result
+
+    def sample_provable_goals(self, *args, **kwargs):
+        raise ScientificSamplingForbidden(
+            'scientific route forbids mutable global RNG sampling'
+        )
+
+    def sample_actions(self, *args, **kwargs):
+        raise ScientificSamplingForbidden(
+            'scientific route forbids mutable global RNG sampling'
+        )
