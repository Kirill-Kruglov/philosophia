+class DeterministicLogitModel:
+    """Y wins at the payload position; N wins at EOS."""
+
+    def __init__(self, inner):
+        self._inner = inner
+
+    def parameters(self):
+        return self._inner.parameters()
+
+    def eval(self):
+        self._inner.eval()
+        return self
+
+    def train(self, mode=True):
+        return self._inner.train(mode)
+
+    def __call__(self, token_ids, attention_mask=None):
+        batch, seq, vocab = token_ids.shape[0], token_ids.shape[1], 128
+        logits = torch.zeros(batch, seq, vocab)
+        eos_id = 2
+        for i in range(batch):
+            eos_pos = None
+            for j in range(int(token_ids.shape[1]) - 1, -1, -1):
+                if int(token_ids[i, j].item()) == eos_id:
+                    eos_pos = j
+                    break
+            self_assert = eos_pos is not None
+            if not self_assert:
+                raise AssertionError('missing EOS in adversarial fixture')
+            payload_pos = eos_pos - 1
+            logits[i, payload_pos, ord('Y')] = 10.0
+            logits[i, payload_pos, ord('N')] = 0.0
+            logits[i, eos_pos, ord('N')] = 10.0
+            logits[i, eos_pos, ord('Y')] = 0.0
+        return type('Out', (), {'logits': logits})()
+
+
+def _attach_fake_logits(sci_policy: ScientificLMPolicy) -> None:
