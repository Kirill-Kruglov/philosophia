+++ b/learning/test_mcts_expansion_counter.py
@@ -0,0 +1,219 @@
+#!/usr/bin/env python3
+"""Regression tests for MonteCarloTreeSearch.evaluate entered-iteration counts.
+
+The pre-repair implementation returned the zero-based loop index `i`, so
+exhaustion of budget B and success on the final allowed iteration both
+reported B-1. These tests must fail against that old return.
+"""
+
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+LEARNING_DIR = Path(__file__).resolve().parent
+if str(LEARNING_DIR) not in sys.path:
+    sys.path.insert(0, str(LEARNING_DIR))
+
+from proofsearch import MonteCarloTreeSearch  # noqa: E402
+
+
+class DummyPolicy:
+    def initialize(self, leaf):
+        children = leaf.children() or []
+        n = max(1, len(children))
+        for child in children:
+            child._prior_policy = 1.0 / n
+            child._value_estimate = 0.0
+
+    def evaluate(self, leaf):
+        children = leaf.children() or []
+        if not children:
+            return np.array([1.0]), 0.0
+        n = len(children)
+        return np.ones(n) / n, 0.0
+
+
+class FakeNode:
+    """Minimal duck-typed search node for counter tests. Not a real proof tree."""
+
+    def __init__(
+            self,
+            terminal=False,
+            solved=False,
+            parent=(None, None),
+            action_name='a0',
+            terminal_at_depth=None,
+            depth=0,
+    ):
+        self._terminal = bool(terminal)
+        self._solved = bool(solved)
+        self._parent = parent
+        self._action_name = action_name
+        self._children = None
+        self._visits = 0
+        self._reward = 0
+        self._prior_policy = 1.0
+        self._value_estimate = 0.0
+        self._index = None
+        self._is_dead = False
+        self._terminal_at_depth = terminal_at_depth
+        self._depth = depth
+        self.state_node = self
+
+    def is_conjunctive(self):
+        return False
+
+    def is_terminal(self):
+        return self._terminal
+
+    def is_solved(self):
+        if self._solved or self._terminal:
+            return True
+        if self._children:
+            return any(c.is_solved() for c in self._children)
+        return False
+
+    def is_leaf(self):
+        return (not self._terminal) and self._children is None
+
+    def is_dead(self):
+        return self._is_dead
+
+    def mark_dead(self):
+        self._is_dead = True
+
+    def mark_solved(self, action=None):
+        self._solved = True
+        parent, parent_action = self._parent
+        if parent is not None:
+            parent.mark_solved(parent_action)
+
+    def children(self):
+        return self._children
+
+    def expand(self, only_if_leaf=True):
+        if only_if_leaf:
+            assert self.is_leaf()
+        child_depth = self._depth + 1
+        child_terminal = (
+            self._terminal_at_depth is not None
+            and child_depth >= self._terminal_at_depth
+        )
+        child = FakeNode(
+            terminal=child_terminal,
+            parent=(self, self._action_name),
+            action_name=self._action_name,
+            terminal_at_depth=self._terminal_at_depth,
+            depth=child_depth,
+        )
+        self._children = [child]
+        return
+
+    def get_path_from_root(self, root=None):
+        if self is root or self._parent[0] is None:
+            return []
+        parent, action = self._parent
+        return parent.get_path_from_root(root) + [action]
+
+
+def _attach_dummy_child(root):
+    child = FakeNode(parent=(root, 'dummy'), action_name='dummy', depth=1)
+    child._visits = 1
+    child._reward = 0.0
+    child._prior_policy = 1.0
+    root._children = [child]
+    root._visits = 1
+    return child
+
+
+def _run(root, budget, start_index=0):
+    mcts = MonteCarloTreeSearch(DummyPolicy(), budget=budget, use_policy=True)
+    solved, pi, value, n_entered = mcts.evaluate(
+        root, start_index=start_index, verbose=False)
+    return solved, pi, value, n_entered
+
+
+class TestMctsExpansionCounter(unittest.TestCase):
+    def test_zero_work_already_solved_returns_0(self):
+        root = FakeNode(solved=True)
+        _attach_dummy_child(root)
+        solved, _, _, n_entered = _run(root, budget=8)
+        self.assertTrue(solved)
+        self.assertEqual(n_entered, 0)
+
+    def test_zero_budget_returns_0(self):
+        root = FakeNode(solved=True)
+        _attach_dummy_child(root)
+        solved, _, _, n_entered = _run(root, budget=0)
+        self.assertTrue(solved)
+        self.assertEqual(n_entered, 0)
+
+    def test_one_entered_iteration_returns_1(self):
+        root = FakeNode(terminal_at_depth=1)
+        solved, _, _, n_entered = _run(root, budget=8)
+        self.assertTrue(solved)
+        self.assertEqual(n_entered, 1)
+        self.assertEqual(root._index, 0)
+
+    def test_early_success_not_on_final_iteration(self):
+        root = FakeNode(terminal_at_depth=3)
+        solved, _, _, n_entered = _run(root, budget=8)
+        self.assertTrue(solved)
+        self.assertEqual(n_entered, 3)
+        self.assertLess(n_entered, 8)
+
+    def test_exhaustion_returns_budget_not_b_minus_one(self):
+        budget = 5
+        root = FakeNode()
+        solved, _, _, n_entered = _run(root, budget=budget)
+        self.assertFalse(solved)
+        self.assertEqual(n_entered, budget)
+        self.assertNotEqual(n_entered, budget - 1)
+
+    def test_success_on_final_allowed_iteration_returns_budget(self):
+        budget = 4
+        root = FakeNode(terminal_at_depth=budget)
+        solved, _, _, n_entered = _run(root, budget=budget)
+        self.assertTrue(solved)
+        self.assertEqual(n_entered, budget)
+        self.assertNotEqual(n_entered, budget - 1)
+
+    def test_leaf_index_keeps_zero_based_loop_index(self):
+        start_index = 10
+        budget = 3
+        root = FakeNode()
+        solved, _, _, n_entered = _run(root, budget=budget, start_index=start_index)
+        self.assertFalse(solved)
+        self.assertEqual(n_entered, budget)
+        self.assertEqual(root._index, start_index + 0)
+        node = root
+        expected_i = 0
+        while node.children():
+            self.assertEqual(node._index, start_index + expected_i)
+            node = node.children()[0]
+            expected_i += 1
+            if expected_i >= budget:
+                break
+
+    def test_dead_traversal_counts_entered_iterations(self):
+        """All-dead children: every budget iteration is entered; tree_policy returns None."""
+        root = FakeNode()
+        dead = FakeNode(parent=(root, 'd'), action_name='d', depth=1)
+        dead.mark_dead()
+        dead._visits = 1
+        dead._reward = 0.0
+        dead._prior_policy = 1.0
+        root._children = [dead]
+        root._visits = 1
+        budget = 4
+        solved, _, _, n_entered = _run(root, budget=budget)
+        self.assertFalse(solved)
+        self.assertEqual(n_entered, budget)
+
+
+if __name__ == '__main__':
+    unittest.main()
