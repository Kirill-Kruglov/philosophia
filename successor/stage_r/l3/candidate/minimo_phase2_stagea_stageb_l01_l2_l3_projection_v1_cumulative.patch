+    def test_isolated_real_nat_add_fresh_process_replay(self):
+        env = os.environ.copy()
+        env['PYTHONHASHSEED'] = '0'
+        env['PHASE2_LEARNING_DIR'] = str(LEARNING_DIR)
+        script = (
+            'import os, sys\n'
+            'sys.path.insert(0, os.environ["PHASE2_LEARNING_DIR"])\n'
+            'from test_phase2_root import isolated_nat_add_replay_bytes\n'
+            'sys.stdout.buffer.write(isolated_nat_add_replay_bytes())\n'
+        )
+        runs = []
+        for _ in range(2):
+            proc = subprocess.run(
+                [sys.executable, '-c', script],
+                env=env,
+                cwd=str(LEARNING_DIR),
+                capture_output=True,
+                check=False,
+            )
+            if proc.returncode != 0:
+                self.fail(proc.stderr.decode('utf-8', errors='replace'))
+            runs.append(proc.stdout)
+        self.assertTrue(runs[0])
+        self.assertEqual(runs[0], runs[1])
+        payload = json.loads(runs[0].decode('ascii'))
+        self.assertGreaterEqual(payload['canonical_record']['assigned_cap'], 4)
+        self.assertTrue(payload['state_dict_hash'])
+        self.assertTrue(payload['learner_spec_hash'])
+
+    def test_two_fresh_processes_production_root_replay(self):
+        env = os.environ.copy()
+        env['PYTHONHASHSEED'] = '0'
+        env['PHASE2_LEARNING_DIR'] = str(LEARNING_DIR)
+        script = (
+            'import os, sys\n'
+            'sys.path.insert(0, os.environ["PHASE2_LEARNING_DIR"])\n'
+            'from test_phase2_root import production_search_bytes\n'
+            'sys.stdout.buffer.write(production_search_bytes(int(sys.argv[1])))\n'
+        )
+        runs = []
+        for seed in (1, 2):
+            proc = subprocess.run(
+                [sys.executable, '-c', script, str(seed)],
+                env=env,
+                cwd=str(LEARNING_DIR),
+                capture_output=True,
+                check=False,
+            )
+            if proc.returncode != 0:
+                self.fail(proc.stderr.decode('utf-8', errors='replace'))
+            runs.append(proc.stdout)
+        self.assertTrue(runs[0])
+        self.assertEqual(runs[0], runs[1])
+
+
+def production_search_bytes(shuffle_seed: int) -> bytes:
+    import random
+    from phase2_root import make_scientific_search_root
+    from phase2_spec import tiny_scientific_spec
+    from test_phase2_search import ScientificFakeNode
+
+    actions = ['zeta', 'alpha', 'mu:' + 'x' * 40]
+    rng = random.Random(shuffle_seed)
+    shuffled = list(actions)
+    rng.shuffle(shuffled)
+    spec = tiny_scientific_spec(n_positions=128)
+    root = make_scientific_search_root(
+        spec, budget=1, artifact_id='replay', action_timeout_s=5.0)
+    if type(root.policy).__name__ != 'ScientificLMPolicy':
+        raise RuntimeError('replay did not use ScientificLMPolicy')
+    node = ScientificFakeNode(raw_actions=shuffled)
+    record, _pi, _value = root.run(node)
+    payload = {
+        'actions': list(node._canonical_expansion.ordered_serializations),
+        'children': list(node._canonical_expansion.child_state_strings),
+        'queries': list(node._canonical_expansion.policy_queries),
+        'value_queries': list(node._canonical_expansion.value_queries),
+        'record': json.loads(record.canonical_bytes().decode('ascii')),
+        'policy': type(root.policy).__name__,
+    }
+    return json.dumps(
+        payload, sort_keys=True, separators=(',', ':'), ensure_ascii=True
+    ).encode('ascii')
+
+
+def isolated_nat_add_replay_bytes() -> bytes:
+    from phase2_isolated import run_isolated_scientific_item
