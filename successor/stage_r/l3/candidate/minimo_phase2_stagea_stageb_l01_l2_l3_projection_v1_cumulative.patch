+def infer_scaffold(plan):
+    gadget = gadget_node(plan)
+    if gadget['kind'] == 'NOT_INTRO':
+        return 'C'
+    if gadget['kind'] == 'OR_ELIM' and gadget['left_branch']['kind'] == 'EXFALSO':
+        return 'B'
+    return 'A'
+
