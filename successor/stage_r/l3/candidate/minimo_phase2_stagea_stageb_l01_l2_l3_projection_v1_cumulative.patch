+        with torch.no_grad():
+            next(b.model.parameters()).add_(1.0)
+        b_manifest = make_checkpoint_manifest(spec, b.model, b.optimizer)
+        with self.assertRaises(ScientificLoadMismatch):
+            assert_manifest_matches(a.manifest, b_manifest)
+        with self.assertRaises(ScientificLoadMismatch):
+            load_scientific_checkpoint(blob, b_manifest, b.model, b.optimizer)
+
+    def test_optimizer_domains_and_exact_types_fail_closed(self):
+        spec = cpu_debug_scientific_spec()
+        cases = {
+            'lr_nan': ('optimizer_lr', float('nan')),
+            'lr_inf': ('optimizer_lr', float('inf')),
+            'lr_neg': ('optimizer_lr', -1e-4),
+            'eps_bool': ('optimizer_eps', True),
+            'eps_str': ('optimizer_eps', '1e-8'),
+            'eps_zero': ('optimizer_eps', 0.0),
+            'wd_neg': ('optimizer_weight_decay', -0.01),
+            'beta_high': ('optimizer_betas', [0.9, 1.0]),
+            'beta_neg': ('optimizer_betas', [-0.1, 0.999]),
+            'beta_bool': ('optimizer_betas', [True, 0.999]),
+        }
+        for name, (key, value) in cases.items():
+            with self.subTest(name=name):
+                mutated = dict(spec)
+                mutated[key] = value
+                with self.assertRaises(ScientificSpecError):
+                    validate_scientific_spec(mutated)
+        fused = dict(spec)
+        fused['optimizer_fused'] = True
+        fused['optimizer_foreach'] = True
+        with self.assertRaises(ScientificSpecError):
+            validate_scientific_spec(fused)
+
+    def test_init_seed_is_required_and_scoped(self):
+        import torch
