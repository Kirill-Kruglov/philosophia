+#!/usr/bin/env python3
+"""Contract C: canonical full actions, overflow-whole-item, replay invariance."""
+
+from __future__ import annotations
+
+import json
+import os
+import random
+import subprocess
+import sys
+import time
+import unittest
+from pathlib import Path
+
+LEARNING_DIR = Path(__file__).resolve().parent
+if str(LEARNING_DIR) not in sys.path:
+    sys.path.insert(0, str(LEARNING_DIR))
+
+from phase2_actions import (  # noqa: E402
+    ActionEnumerationTimeout,
+    DuplicateActionSerialization,
+    ItemQueryOverflowRefusal,
+    canonical_action_ascii,
+    canonicalize_actions,
+    expand_leaf_canonical,
+    materialize_actions_interruptible,
+    preflight_action_policy_queries,
+)
+from phase2_codec import QueryCodec  # noqa: E402
+from phase2_root import make_scientific_search_root  # noqa: E402
+from phase2_spec import tiny_scientific_spec  # noqa: E402
+from test_phase2_search import ScientificFakeNode  # noqa: E402
+
+
+class TestCanonicalActions(unittest.TestCase):
+    def test_retains_action_longer_than_75(self):
+        long_action = 'apply ' + ('lemma' * 20)
+        self.assertGreater(len(long_action), 75)
+        ordered = canonicalize_actions(
+            ['short', long_action, 'mid'], timeout_s=1.0)
+        serials = [canonical_action_ascii(a) for a in ordered]
+        self.assertIn(long_action, serials)
+        self.assertEqual(serials, sorted(serials))
+
+    def test_duplicate_serialization_refused(self):
+        with self.assertRaises(DuplicateActionSerialization):
+            canonicalize_actions(['alpha', 'beta', 'alpha'], timeout_s=1.0)
+
+    def test_shuffled_enumeration_metamorphic(self):
+        base = ['zeta', 'alpha', 'mu:' + 'x' * 80]
+        orders = [
+            list(base),
+            list(reversed(base)),
+            ['mu:' + 'x' * 80, 'zeta', 'alpha'],
+        ]
+        canonical = None
+        for raw in orders:
+            got = [canonical_action_ascii(a) for a in canonicalize_actions(raw, timeout_s=1.0)]
+            if canonical is None:
+                canonical = got
+            self.assertEqual(got, canonical)
+
+    def test_real_timeout_is_reachable(self):
+        start = time.monotonic()
+        with self.assertRaises(ActionEnumerationTimeout):
+            materialize_actions_interruptible(('never_return',), 0.3)
+        self.assertLess(time.monotonic() - start, 2.0)
+
+    def test_full_query_overflow_refuses_whole_item(self):
+        codec = QueryCodec(n_positions=32)
+        state = 'S'
+        actions = ['short', 'X' * 80]
+        with self.assertRaises(ItemQueryOverflowRefusal) as ctx:
+            preflight_action_policy_queries(
+                codec, state, actions, artifact_id='item-7')
+        self.assertEqual(ctx.exception.artifact_id, 'item-7')
+        self.assertEqual(list(actions), ['short', 'X' * 80])
+
+    def test_historical_755_767_action_query_whole_or_refuse(self):
+        action_755 = 'A' * 755
+        action_767 = 'B' * 767
+        admit = QueryCodec(n_positions=2048)
+        q755 = admit.format_action_query('st', action_755)
+        q767 = admit.format_action_query('st', action_767)
+        e755 = admit.encode(q755, kind='action', artifact_id='a755')
+        e767 = admit.encode(q767, kind='action', artifact_id='a767')
+        self.assertIn(action_755, e755.text)
+        self.assertIn(action_767, e767.text)
+        self.assertNotIn('[...]', e755.text)
+        refuse = QueryCodec(n_positions=64)
+        with self.assertRaises(ItemQueryOverflowRefusal):
+            preflight_action_policy_queries(
+                refuse, 'st', [action_755, 'ok'], artifact_id='bound')
+
+    def test_two_fresh_processes_byte_identical_search_record(self):
+        env = os.environ.copy()
+        env['PYTHONHASHSEED'] = '0'
+        env['PHASE2_LEARNING_DIR'] = str(LEARNING_DIR)
+        script = (
+            'import os, sys\n'
+            'sys.path.insert(0, os.environ["PHASE2_LEARNING_DIR"])\n'
+            'from test_phase2_actions import synthetic_search_bytes\n'
+            'import sys as _s\n'
+            '_s.stdout.buffer.write(synthetic_search_bytes(int(_s.argv[1])))\n'
+        )
+        runs = []
+        for seed in (1, 2, 3):
+            proc = subprocess.run(
+                [sys.executable, '-c', script, str(seed)],
+                env=env,
+                cwd=str(LEARNING_DIR),
+                capture_output=True,
+                check=True,
+            )
+            runs.append(proc.stdout)
+        self.assertTrue(runs[0])
+        self.assertEqual(runs[0], runs[1])
+        self.assertEqual(runs[1], runs[2])
+
+    def test_misspelled_action_kwargs_do_not_disappear(self):
+        with self.assertRaises(TypeError):
+            canonicalize_actions(['b', 'a'], timeout=0.0001)
+        with self.assertRaises(TypeError):
+            expand_leaf_canonical(
+                ScientificFakeNode(raw_actions=['a']),
+                codec=QueryCodec(n_positions=32),
+                artifact_id='x',
+                timeout_s=1.0,
+                nonsense=True,
+            )
+
+
+def synthetic_search_bytes(shuffle_seed: int) -> bytes:
+    actions = ['zeta', 'alpha', 'mu:' + 'x' * 40]
+    rng = random.Random(shuffle_seed)
+    shuffled = list(actions)
+    rng.shuffle(shuffled)
+    spec = tiny_scientific_spec(n_positions=128)
+    root = make_scientific_search_root(
+        spec, budget=1, artifact_id='synth', action_timeout_s=5.0)
+    node = ScientificFakeNode(raw_actions=shuffled)
+    record, _pi, _value = root.run(node)
+    payload = {
+        'actions': list(node._canonical_expansion.ordered_serializations),
+        'children': list(node._canonical_expansion.child_state_strings),
+        'queries': list(node._canonical_expansion.policy_queries),
+        'value_queries': list(node._canonical_expansion.value_queries),
+        'record': json.loads(record.canonical_bytes().decode('ascii')),
+        'policy': type(root.policy).__name__,
+    }
+    return json.dumps(
+        payload, sort_keys=True, separators=(',', ':'), ensure_ascii=True
+    ).encode('ascii')
+
+
+if __name__ == '__main__':
+    unittest.main()
