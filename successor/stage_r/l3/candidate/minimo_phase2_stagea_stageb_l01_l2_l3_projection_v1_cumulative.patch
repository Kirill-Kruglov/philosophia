+    evidence = run_isolated_scientific_item(
+        {
+            'theory_text': theory,
+            'premises': ['+_z', '+_s'],
+            'goal': '(= (+ z z) z)',
+        },
+        spec,
+        budget=4,
+        timeout_s=120.0,
+        artifact_id='nat-add',
+    )
+    payload = {
+        'canonical_record': evidence['canonical_record'],
+        'ordered_serializations': evidence['ordered_serializations'],
+        'learner_spec_hash': evidence['learner_spec_hash'],
+        'state_dict_hash': evidence['state_dict_hash'],
+        'optimizer_state_hash': evidence['optimizer_state_hash'],
+        'entered': evidence['entered_tree_policy_iterations'],
