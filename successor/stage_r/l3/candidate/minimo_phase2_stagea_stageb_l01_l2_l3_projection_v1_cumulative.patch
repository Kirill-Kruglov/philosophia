+        del spec['n_head']
+        with self.assertRaises(ScientificSpecError) as ctx:
+            validate_scientific_spec(spec)
+        self.assertIn('n_head', str(ctx.exception))
+
+    def test_extra_field_fails_closed(self):
+        spec = cpu_debug_scientific_spec()
+        spec['n_layer_extra'] = 8
+        with self.assertRaises(ScientificSpecError) as ctx:
+            validate_scientific_spec(spec)
+        self.assertIn('n_layer_extra', str(ctx.exception))
+
+    def test_mismatched_head_embd_fails_closed(self):
+        spec = cpu_debug_scientific_spec()
+        spec['n_head'] = 3
+        with self.assertRaises(ScientificSpecError):
+            validate_scientific_spec(spec)
+
+    def test_spec_hash_is_canonical(self):
+        a = cpu_debug_scientific_spec()
