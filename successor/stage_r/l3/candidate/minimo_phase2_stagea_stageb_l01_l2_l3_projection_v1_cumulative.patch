+#!/usr/bin/env python3
+"""Contract A: fail-closed scientific constructor, spec hash, manifest."""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import sys
+import unittest
+from pathlib import Path
+from unittest import mock
+
+LEARNING_DIR = Path(__file__).resolve().parent
+if str(LEARNING_DIR) not in sys.path:
+    sys.path.insert(0, str(LEARNING_DIR))
+
+from phase2_spec import (  # noqa: E402
+    SCIENTIFIC_SPEC_KEYS,
+    ScientificDeviceUnavailable,
+    ScientificLoadMismatch,
+    ScientificSpecError,
+    assert_manifest_matches,
+    canonical_spec_hash,
+    construct_scientific_lm,
+    cpu_debug_scientific_spec,
