+#!/usr/bin/env python3
+"""Scientific MCTS accounting: entered iterations and new-leaf expansions."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from typing import Callable
+
+import numpy as np
+
+from phase2_actions import (
+    ArtifactIdLimitRefusal,
+    expand_leaf_canonical,
+    refuse_uncontained_peano,
+    whole_item_worker_capability_granted,
+)
+from phase2_codec import ArtifactIdError, QueryCodec, validate_artifact_id
+from phase2_timeout import require_positive_finite_timeout
+from proofsearch import MonteCarloTreeSearch
+
+
+def require_exact_non_negative_int(value, *, name='budget') -> int:
+    if type(value) is bool or type(value) is not int or value < 0:
+        raise ValueError(f'{name} must be an exact non-negative int')
+    return value
+
+
+@dataclass(frozen=True)
+class ScientificSearchRecord:
+    entered_tree_policy_iterations: int
+    new_leaf_expansions: int
+    terminal_hits: int
+    dead_traversals: int
+    solved: bool
+    assigned_cap: int
+    canonical_nodes: tuple[dict, ...] = ()
+
+    def canonical_bytes(self) -> bytes:
+        payload = {
+            'assigned_cap': self.assigned_cap,
+            'canonical_nodes': list(self.canonical_nodes),
+            'dead_traversals': self.dead_traversals,
+            'entered_tree_policy_iterations': self.entered_tree_policy_iterations,
+            'new_leaf_expansions': self.new_leaf_expansions,
+            'solved': self.solved,
+            'terminal_hits': self.terminal_hits,
+        }
+        return json.dumps(
+            payload, sort_keys=True, separators=(',', ':'), ensure_ascii=True
+        ).encode('ascii')
+
+
+class ScientificMonteCarloTreeSearch(MonteCarloTreeSearch):
+    """MCTS with exact work counters and canonical leaf expansion."""
+
+    def __init__(
+            self,
+            default_policy,
+            budget=1000,
+            *,
+            codec: QueryCodec,
+            action_timeout_s: float | None = 0.2,
+            artifact_id: str = 'item',
+            clock: Callable[[], float] | None = None,
+            child_factory=None,
+            use_policy=True,
+            exploration_prefix=None,
+            worker_capability=None,
+    ):
+        budget = require_exact_non_negative_int(budget, name='budget')
+        super().__init__(
+            default_policy,
+            budget=budget,
+            exploration_prefix=exploration_prefix,
+            use_policy=use_policy,
+        )
+        self._codec = codec
+        self._worker_capability = worker_capability
+        authorized = whole_item_worker_capability_granted(worker_capability)
+        if authorized:
+            self._action_timeout_s = None
+        else:
+            self._action_timeout_s = require_positive_finite_timeout(action_timeout_s)
+        self._artifact_id = validate_artifact_id(artifact_id)
+        self._clock = clock
+        self._child_factory = child_factory
+
+    def evaluate(self, root, start_index=0, on_expand=None, verbose=False):
+        import time
+
+        clock = self._clock or time.monotonic
+        refuse_uncontained_peano(root, self._worker_capability)
+        entered = 0
+        new_leaf_expansions = 0
+        terminal_hits = 0
+        dead_traversals = 0
+        canonical_nodes: list[dict] = []
+
+        for i in range(self._budget):
+            if root.is_solved():
+                break
+
+            entered += 1
+            leaf = self._tree_policy(root)
+
+            if leaf is None:
+                dead_traversals += 1
+                continue
+
+            refuse_uncontained_peano(leaf, self._worker_capability)
+            leaf._index = start_index + i
+
+            if leaf.is_terminal():
+                leaf.mark_solved()
+                self._backpropagate_reward(leaf, 1)
+                terminal_hits += 1
+                continue
+
+            try:
+                node_artifact_id = validate_artifact_id(f'{self._artifact_id}:n{i}')
+            except ArtifactIdError as exc:
+                raise ArtifactIdLimitRefusal.from_error(exc) from exc
+            expansion = expand_leaf_canonical(
+                leaf,
+                codec=self._codec,
+                timeout_s=self._action_timeout_s,
+                artifact_id=node_artifact_id,
+                child_factory=self._child_factory,
+                worker_capability=self._worker_capability,
+            )
+            new_leaf_expansions += 1
+            canonical_nodes.append({
+                'child_state_strings': list(expansion.child_state_strings),
+                'ordered_serializations': list(expansion.ordered_serializations),
+                'policy_queries': list(expansion.policy_queries),
+                'value_queries': list(expansion.value_queries),
+            })
+
+            if self._use_default_policy and self._default_policy:
+                self._default_policy.initialize(leaf)
+
+            if on_expand is not None:
+                path = leaf.get_path_from_root()
+                on_expand([str(a) for a in path])
+
+            _, reward = self._default_policy.evaluate(leaf)
+            self._backpropagate_reward(leaf, reward)
+
+        children = root.children()
+        if not children:
+            pi = np.array([])
+            value = 0.0
+        else:
+            pi = self._policy(root)
+            value = max(
+                p * (c._reward / max(1, c._visits))
+                for p, c in zip(pi, children)
+            )
+
+        record = ScientificSearchRecord(
+            entered_tree_policy_iterations=entered,
+            new_leaf_expansions=new_leaf_expansions,
+            terminal_hits=terminal_hits,
+            dead_traversals=dead_traversals,
+            solved=bool(root.is_solved()),
+            assigned_cap=int(self._budget),
+            canonical_nodes=tuple(canonical_nodes),
+        )
+        return record, pi, value
