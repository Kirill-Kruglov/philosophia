+def first_stream_word(root_key, draw_index):
+    message = (
+        L2_PRF_DOMAIN + L2_PRF_SEPARATOR
+        + draw_index.to_bytes(8, 'big')
+        + (0).to_bytes(8, 'big')
+    )
+    block = hmac.new(root_key, message, hashlib.sha256).digest()
+    return int.from_bytes(block[0:8], 'big')
+
