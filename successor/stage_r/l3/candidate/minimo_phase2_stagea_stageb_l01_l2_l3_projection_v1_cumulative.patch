+#!/usr/bin/env python3
+"""Canonical max_pos_neg_ratio; no silent fallback to max_positive_negative_ratio=10."""
+
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+from omegaconf import OmegaConf
+
+LEARNING_DIR = Path(__file__).resolve().parent
+if str(LEARNING_DIR) not in sys.path:
+    sys.path.insert(0, str(LEARNING_DIR))
+
+from phase2_config import (  # noqa: E402
+    ConfigKeyError,
+    resolve_max_pos_neg_ratio,
+)
+
+
+class TestMaxPosNegRatio(unittest.TestCase):
+    def test_yaml_canonical_key_is_five_not_ten(self):
+        cfg = OmegaConf.load(LEARNING_DIR / 'config' / 'agent' / 'mcts-lm.yaml')
+        self.assertEqual(resolve_max_pos_neg_ratio(cfg.policy), 5)
+        self.assertNotEqual(resolve_max_pos_neg_ratio(cfg.policy), 10)
+
+    def test_scientific_requires_canonical_key(self):
+        with self.assertRaises(ConfigKeyError):
+            resolve_max_pos_neg_ratio({}, scientific=True)
+        self.assertEqual(resolve_max_pos_neg_ratio({'max_pos_neg_ratio': 7}, scientific=True), 7)
+
+    def test_long_key_never_silently_applies(self):
+        with self.assertRaises(ConfigKeyError):
+            resolve_max_pos_neg_ratio({'max_positive_negative_ratio': 10})
+        with self.assertRaises(ConfigKeyError):
+            resolve_max_pos_neg_ratio({
+                'max_pos_neg_ratio': 5,
+                'max_positive_negative_ratio': 10,
+            })
+
+    def test_legacy_default_only_when_canonical_absent(self):
+        self.assertEqual(resolve_max_pos_neg_ratio({}), 10)
+
+    def test_rejects_bool_float_string_zero_negative(self):
+        for value in (True, False, 5.0, '5', 0, -1):
+            with self.subTest(value=value):
+                with self.assertRaises(ConfigKeyError):
+                    resolve_max_pos_neg_ratio({'max_pos_neg_ratio': value})
+                with self.assertRaises(ConfigKeyError):
+                    resolve_max_pos_neg_ratio({'max_pos_neg_ratio': value}, scientific=True)
+
+    def test_lmpolicy_uses_resolver(self):
+        source = (LEARNING_DIR / 'proofsearch.py').read_text(encoding='utf-8')
+        self.assertIn('resolve_max_pos_neg_ratio', source)
+        self.assertNotIn(
+            "config.get('max_positive_negative_ratio', 10)",
+            source,
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
