+        other = construct_scientific_lm(spec)
+        load_scientific_checkpoint(blob, bundle.manifest, other.model, other.optimizer)
+        actual = make_checkpoint_manifest(spec, other.model, other.optimizer)
+        assert_manifest_matches(bundle.manifest, actual)
+
+    def test_load_rejects_state_mismatch(self):
+        import torch
+        spec = tiny_scientific_spec()
+        a = construct_scientific_lm(spec)
