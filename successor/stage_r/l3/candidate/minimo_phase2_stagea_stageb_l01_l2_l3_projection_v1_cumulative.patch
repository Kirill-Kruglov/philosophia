+        self.assertEqual(canonical_spec_hash(a), canonical_spec_hash(b))
+
+    def test_cpu_construction_parameter_count_and_hash(self):
+        bundle = construct_scientific_lm(cpu_debug_scientific_spec())
+        self.assertEqual(bundle.parameter_count, CPU_DEBUG_PARAM_COUNT)
+        self.assertEqual(bundle.spec['expected_parameter_count'], CPU_DEBUG_PARAM_COUNT)
+        self.assertEqual(bundle.manifest['parameter_count'], CPU_DEBUG_PARAM_COUNT)
+        self.assertEqual(bundle.spec['n_layer'], 2)
+        self.assertEqual(bundle.spec['n_head'], 2)
+        self.assertEqual(bundle.spec['n_embd'], 128)
+        self.assertEqual(bundle.model.config.attn_pdrop, 0.0)
+        self.assertEqual(bundle.model.config.embd_pdrop, 0.0)
+        self.assertEqual(bundle.model.config.resid_pdrop, 0.0)
+        defaults = bundle.optimizer.defaults
+        self.assertFalse(defaults['maximize'])
+        self.assertFalse(defaults['foreach'])
+        self.assertFalse(defaults['capturable'])
+        self.assertFalse(defaults['differentiable'])
+        self.assertFalse(defaults.get('fused', False))
+        self.assertEqual(str(next(bundle.model.parameters()).device), 'cpu')
+        self.assertEqual(len(canonical_spec_hash(bundle.spec)), 64)
+        self.assertIn('resolved_model_config_hash', bundle.manifest)
+        self.assertEqual(len(bundle.manifest['resolved_model_config_hash']), 64)
+        import torch as _torch
+        import transformers as _transformers
+        self.assertEqual(bundle.manifest['torch_version'], _torch.__version__)
+        self.assertEqual(bundle.manifest['transformers_version'], _transformers.__version__)
+        self.assertEqual(
+            bundle.manifest['resolved_model_config'].get('transformers_version'),
+            _transformers.__version__,
+        )
+
+    def test_architecture_ignores_cuda_availability(self):
+        spec = cpu_debug_scientific_spec()
+        with mock.patch('torch.cuda.is_available', return_value=True):
+            bundle = construct_scientific_lm(spec)
