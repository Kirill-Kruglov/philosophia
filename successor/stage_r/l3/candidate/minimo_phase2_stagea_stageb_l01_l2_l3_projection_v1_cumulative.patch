+        self.assertEqual(a.manifest['state_dict_hash'], b.manifest['state_dict_hash'])
+        blob = {
+            'manifest': a.manifest,
+            'model_state_dict': a.model.state_dict(),
+            'optimizer_state_dict': a.optimizer.state_dict(),
